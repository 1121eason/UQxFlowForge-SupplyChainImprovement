         </exclusiveGateway>
         <exclusiveGateway gatewayDirection="Converging" id="TB_R2_DeliveryCheckMerge">
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
            </extensionElements>
