            <incoming>FFR_b4d617a2dcac51cc99392c7225e3f195</incoming>
            <outgoing>FFR_b2789ca6fc1459e1b50bfe2c2d2bb09b</outgoing>
         </task>
         <task completionQuantity="1" id="TB_R3_RecordTechnicianEvidence" isForCompensation="false" name="Record test and repair evidence [R3]" startQuantity="1">
            <documentation id="sid-e585d7cb-1ccb-4f7d-8eb7-b21513b35cb2">R3 / I-02; triage and resource optimisation. Record component tests, fault observations, work performed and the actual rig result against this request before selecting pass/escalation. Existing evidence may be reused when verified; no absence of current records or new failure rate is assumed.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>FFR_b2789ca6fc1459e1b50bfe2c2d2bb09b</incoming>
            <outgoing>TB_R3_FlowEvidenceToOutcome</outgoing>
         </task>
         <exclusiveGateway gatewayDirection="Diverging" id="FFR_7cca907496ca5afd80e67772d08c4215" name="Test passed?">
            <documentation id="sid-70e19b9a-e052-49f1-a3c0-04f90fb88029">Technician rig test: pass versus fail; the case gives 40% failure for this test. A fail escalates once to the senior. Case p.4.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-55.0" y="-58.0"/>
            </extensionElements>
            <incoming>TB_R3_FlowEvidenceToOutcome</incoming>
            <outgoing>FFR_d18b4c3101fc5dfb97ac2873e62c888e</outgoing>
            <outgoing>FFR_f5d8e7a7fdb5568187ae1c99f4971d16</outgoing>
         </exclusiveGateway>
         <task completionQuantity="1" id="FFR_141439fe88cc5aef9ff4e9891970f205" isForCompensation="false" name="Place part in Urgent repair tray" startQuantity="1">
            <documentation id="sid-ded7ddcf-46ba-474f-9dea-10a65cfd54ef">Technician: Place part in Urgent repair tray. Case p.4.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
