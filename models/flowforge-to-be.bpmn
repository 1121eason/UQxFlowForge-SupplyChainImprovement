         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
            <signavio:signavioLabel bold="" fill="" fontFamily="" fontSize="12.0" italic="" ref="text_name"/>
         </extensionElements>
         <incoming>TB_F_SG_Carry_SG_CloseWarehouse</incoming>
         <outgoing>TB_F_SG_CloseWarehouse_SG_Closed</outgoing>
      </task>
      <endEvent id="SG_Closed" name="Day closed; open cases tracked">
         <extensionElements>
