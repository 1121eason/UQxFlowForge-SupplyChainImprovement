      <textAnnotation id="SG_ChangeLegend" signavio:alignment="left" textFormat="text/plain">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <text>R1 Single dispatch capture   |   R2 Audit reuse   |   R3 Senior evidence triage   |   R4 Reliable state/location
R5 Physical stock first   |   R6 Early scope and agreed intake   |   R7 Changes reviewed on receipt
Blue = revised activities. Required tests, physical controls, 3pm service windows and both repairer types remain.</text>
      </textAnnotation>
   </process>
