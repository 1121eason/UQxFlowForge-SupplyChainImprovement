            <incoming>TB_R2_F03</incoming>
            <outgoing>FFR_ec5fa42a8b8c5d55a42455e698a6372a</outgoing>
         </task>
         <exclusiveGateway gatewayDirection="Diverging" id="FFR_5ffbca47104e5addae127b385c645e47" name="Part ID exists?">
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
