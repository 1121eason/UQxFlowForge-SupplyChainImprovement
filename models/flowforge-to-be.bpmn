         <task completionQuantity="1" id="FFR_fbaa01591ad557c49b050a5370134425" isForCompensation="false" name="Create part ID" startQuantity="1">
            <documentation id="sid-b2e5863f-1526-44b4-a760-a9dd939a35a6">Inventory Officer: Create part ID. Case p.5.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
