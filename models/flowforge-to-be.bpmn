         </task>
         <sendTask completionQuantity="1" id="TB_RecoveryDispatch" implementation="##unspecified" isForCompensation="false" name="Dispatch received part to PrimeTech" startQuantity="1">
            <documentation id="sid-59ae334d-c409-4bcc-a8ef-9cf046a1b9a0">Actual recovered part required. Preserve the source recovery route: dispatch after actual receipt, without adding the ordinary spare/workshop 3pm wait. The 3pm rule remains for routes to which it applies.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_TB_RecoveryDocs_TB_RecoveryDispatch</incoming>
            <outgoing>TB_F_TB_RecoveryDispatch_TB_RecoveryRecord</outgoing>
         </sendTask>
         <task completionQuantity="1" id="TB_RecoveryRecord" isForCompensation="false" name="Capture handover / reporting outcome [R1 R4]" startQuantity="1">
            <documentation id="sid-2d881233-8bc2-4aaa-afeb-570f2d80549c">Actual handover only. Capture identifiers, location/state, actor/time once; generate required Logistics/Tracking outputs. Verify success. If unavailable, preserve controlled manual handover evidence, open IM-owned output and IO-owned data exceptions for daily reconciliation. Finalise only the resolved item, not an unresolved referral or failed required control.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_TB_RecoveryDispatch_TB_RecoveryRecord</incoming>
            <outgoing>TB_F_TB_RecoveryRecord_TB_Pending</outgoing>
         </task>
