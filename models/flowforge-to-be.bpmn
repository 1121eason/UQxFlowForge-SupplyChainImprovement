      <subProcess completionQuantity="1" id="FFR_2aec60bcec865e10b442a839f09e0cd4" isForCompensation="false" name="T7 | Control urgent changes [R7]" startQuantity="1" triggeredByEvent="false">
         <documentation id="sid-82d2a8f6-bb56-4772-a0f1-4e5818f11936">R7: existing urgent-change handling. Correlate the existing case, assess remaining service window, obtain authorised technical disposition, retain authorised deferral/rejection, and use linked follow-on disposition after physical dispatch. The external message trigger is retained in the parent process.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
            <signavio:signavioLabel bold="" fill="" fontFamily="" fontSize="12.0" italic="" ref="text_name"/>
            <signavio:signavioDiagramMetaData metaKey="revisionid" metaValue="b571c3800e814075beb785aad9b2a4ef"/>
         </extensionElements>
         <incoming>TB_F_SG_Change_FFR_2aec60bcec865e10b442a839f09e0cd4</incoming>
         <outgoing>TB_F_FFR_2aec60bcec865e10b442a839f09e0cd4_SG_ChangeDone</outgoing>
         <laneSet id="sid-6bba823c-59c5-40a8-b820-6ace2a4e20d2" name="T7 | Control urgent changes [R7]">
            <lane id="TB_LS_FFR_2aec60bcec865e10b442a839f09e0cd4_0" name="Inventory Manager">
               <extensionElements>
                  <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
                  <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
                  <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
               </extensionElements>
               <flowNodeRef>TB_ChangeLocalStart</flowNodeRef>
               <flowNodeRef>TB_ChangeLink</flowNodeRef>
               <flowNodeRef>TB_ChangeWindow</flowNodeRef>
               <flowNodeRef>TB_TechDecision</flowNodeRef>
               <flowNodeRef>TB_AlreadySent</flowNodeRef>
               <flowNodeRef>TB_UpdatePlan</flowNodeRef>
               <flowNodeRef>TB_FollowOn</flowNodeRef>
               <flowNodeRef>TB_ChangeJoin</flowNodeRef>
               <flowNodeRef>TB_Communicate</flowNodeRef>
               <flowNodeRef>TB_ChangeDone</flowNodeRef>
            </lane>
         </laneSet>
         <startEvent id="TB_ChangeLocalStart" isInterrupting="true" name="Urgent change requires review">
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-30.0" y="39.0"/>
            </extensionElements>
            <outgoing>TB_F_TB_Change_TB_ChangeLink</outgoing>
         </startEvent>
         <task completionQuantity="1" id="TB_ChangeLink" isForCompensation="false" name="Correlate existing case; record receipt time [R7]" startQuantity="1">
            <documentation id="sid-a98ceac3-2033-49c1-b2ce-8cdb79440e9e">R7 | I-05 | communication optimisation, resource optimisation. Existing CRN/work-line is mandatory. Repeated change messages are idempotent. An unmatched change is clarified and assigned, never launched as an independent repair.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_TB_Change_TB_ChangeLink</incoming>
            <outgoing>TB_F_TB_ChangeLink_TB_ChangeWindow</outgoing>
         </task>
         <task completionQuantity="1" id="TB_ChangeWindow" isForCompensation="false" name="Assess remaining service window [R7]" startQuantity="1">
            <documentation id="sid-ed071111-600e-42ee-9984-c5e92a052ca0">Retain 3pm ordinary dispatch cut-off and discretionary before-8am/after-5pm rejection. Record and communicate exceptions. A late physical arrival is not guaranteed same-day repair.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_TB_ChangeLink_TB_ChangeWindow</incoming>
            <outgoing>TB_F_TB_ChangeWindow_TB_TechDecision</outgoing>
         </task>
         <task completionQuantity="1" id="TB_TechDecision" isForCompensation="false" name="Obtain authorised technical disposition [R7]" startQuantity="1">
            <documentation id="sid-bd39df34-acb8-48f9-b77a-88bb9ac7394f">IM consults Technician/Senior; Senior retains priority and solution authority. Resolve uncertain references before changing the case. Obtain one authorised decision against current plan version.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_TB_ChangeWindow_TB_TechDecision</incoming>
            <outgoing>TB_F_TB_TechDecision_TB_AlreadySent</outgoing>
         </task>
         <exclusiveGateway gatewayDirection="Diverging" id="TB_AlreadySent" name="Already physically dispatched?">
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-55.0" y="-58.0"/>
            </extensionElements>
            <incoming>TB_F_TB_TechDecision_TB_AlreadySent</incoming>
            <outgoing>TB_F_TB_AlreadySent_TB_UpdatePlan</outgoing>
            <outgoing>TB_F_TB_AlreadySent_TB_FollowOn</outgoing>
         </exclusiveGateway>
         <task completionQuantity="1" id="TB_UpdatePlan" isForCompensation="false" name="Apply / retain authorised active plan [R7]" startQuantity="1">
            <documentation id="sid-9e20e086-65e4-4d80-b7c8-bbef3d16e45f">Accept: apply the approved change. Defer/reject: retain the current approved plan and record the reason; outside-hours rejection remains discretionary. Update existing plan atomically/version checked. Recheck state at commit so concurrent handover cannot create contradictory instructions. If dispatch has completed, use linked follow-on disposition. No second repair or duplicate dispatch is launched.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_TB_AlreadySent_TB_UpdatePlan</incoming>
            <outgoing>TB_F_TB_UpdatePlan_TB_ChangeJoin</outgoing>
         </task>
         <task completionQuantity="1" id="TB_FollowOn" isForCompensation="false" name="Create linked follow-on disposition [R7]" startQuantity="1">
            <documentation id="sid-2ac2a43f-5587-4015-bc2c-829536395579">Retain completed shipment history; any later service work needs an authorised linked follow-on outcome. This does not rewrite a completed shipment or immediately start another repair.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_TB_AlreadySent_TB_FollowOn</incoming>
            <outgoing>TB_F_TB_FollowOn_TB_ChangeJoin</outgoing>
         </task>
         <exclusiveGateway gatewayDirection="Converging" id="TB_ChangeJoin">
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
            </extensionElements>
            <incoming>TB_F_TB_UpdatePlan_TB_ChangeJoin</incoming>
            <incoming>TB_F_TB_FollowOn_TB_ChangeJoin</incoming>
            <outgoing>TB_F_TB_ChangeJoin_TB_Communicate</outgoing>
         </exclusiveGateway>
         <task completionQuantity="1" id="TB_Communicate" isForCompensation="false" name="Record and communicate decision / exceptions [R7]" startQuantity="1">
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_TB_ChangeJoin_TB_Communicate</incoming>
