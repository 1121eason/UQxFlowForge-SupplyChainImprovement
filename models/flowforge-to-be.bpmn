            </extensionElements>
            <incoming>TB_F_TB_Match_TB_IntakeJoin</incoming>
            <incoming>TB_F_TB_Authority_TB_IntakeJoin</incoming>
            <outgoing>TB_F_TB_IntakeJoin_TB_Scope</outgoing>
         </exclusiveGateway>
         <task completionQuantity="1" id="TB_Scope" isForCompensation="false" name="Validate references / scope [R6]" startQuantity="1">
            <documentation id="sid-c569bacb-dbfc-46ad-85ef-7ea8fa99166b">Validate mandatory references and contractual part scope before spare searching. Missing or uncertain detail is resolved by human clarification; no invented contract rule or silent acceptance. Pre-shipment validation applies only under the agreed PrimeTech intake protocol.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
