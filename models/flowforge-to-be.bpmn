         </task>
         <task completionQuantity="1" id="TB_R4_SeniorCompletionCapture" isForCompensation="false" name="Capture completion and tray [R4]" startQuantity="1">
            <documentation id="sid-a1b894a2-3244-4d2a-880f-81c529464fc4">R4 / I-03; automation and resource optimisation. The completing role records the correct part ID, request, physical Urgent repair tray location, passed technical outcome, actor and timestamp. Mark repair complete and readiness only; this is not an actual dispatch event. If the device, label or record update fails, retain controlled manual evidence and route the reconciliation exception to IO.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>FFR_53d3776164255acf9e9727de43fc1b2d</incoming>
            <outgoing>TB_R4_FlowSeniorCaptureToDecision</outgoing>
         </task>
         <exclusiveGateway gatewayDirection="Diverging" id="TB_R4_SeniorCaptureDecision" name="Capture succeeded? [R4]">
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-55.0" y="-58.0"/>
            </extensionElements>
            <incoming>TB_R4_FlowSeniorCaptureToDecision</incoming>
            <outgoing>TB_R4_FlowSeniorCaptureSuccess</outgoing>
            <outgoing>TB_R4_FlowSeniorCaptureFailure</outgoing>
         </exclusiveGateway>
         <task completionQuantity="1" id="TB_R4_SeniorManualCapture" isForCompensation="false" name="Record manual completion evidence [R4]" startQuantity="1">
            <documentation id="sid-ec4f2ba6-3eab-4ba7-9a84-70317276bcdd">R4 fallback owned by the completing Senior. Record part ID, request, passed test evidence, tray location, actor and timestamp on the controlled manual record; assign an IO reconciliation exception. Preserve the technical result and do not create a second repair or dispatch event.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_R4_FlowSeniorCaptureFailure</incoming>
            <outgoing>TB_R4_FlowSeniorManualToIOMerge</outgoing>
         </task>
         <exclusiveGateway gatewayDirection="Converging" id="TB_R4_ManualCaptureRoutesMerge">
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
            </extensionElements>
            <incoming>TB_R4_FlowTechManualToIOMerge</incoming>
            <incoming>TB_R4_FlowSeniorManualToIOMerge</incoming>
            <outgoing>TB_R4_FlowManualMergeToIO</outgoing>
         </exclusiveGateway>
         <task completionQuantity="1" id="TB_R4_IOReconcileCompletionCapture" isForCompensation="false" name="Reconcile capture exception [R4]" startQuantity="1">
            <documentation id="sid-fa4c8409-7969-430f-a2b9-f181267461a8">IO owns this visible R4 exception. Verify the controlled manual evidence against the correct part/request and physical tray; restore or reconcile the digital completion event while preserving its original actor/time and correction history. Confirm no duplicate completion event. Release the reconciled repair-complete record for the normal dispatch controls.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_R4_FlowManualMergeToIO</incoming>
            <outgoing>TB_R4_FlowReconciledCompletion</outgoing>
         </task>
