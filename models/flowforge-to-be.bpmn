         <task completionQuantity="1" id="TB_R4_ReviewStaleStates" isForCompensation="false" name="Review stale states and location mismatches" startQuantity="1">
            <documentation id="sid-e12fe9f0-19e9-49d2-97cb-81d3eb86be69">[R4] IO compares observed parts/trays and updated observations with part ID, location, case and completion-state events. Identify stale or missing capture and reconcile controlled manual records where required; repair complete, ready for dispatch and actual dispatch remain distinct.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>FFR_acd8039f96e55ff184bd50b42d00f6b7</incoming>
            <outgoing>TB_R4_C01</outgoing>
         </task>
         <exclusiveGateway gatewayDirection="Diverging" id="TB_R4_DiscrepancyFound" name="Unresolved discrepancy?">
            <documentation id="sid-903bd971-b1ba-4899-8c5c-5ddf4ada8522">[R4] Physical/digital mismatch or stale status requires an IO-owned recovery case.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-55.0" y="-58.0"/>
            </extensionElements>
            <incoming>TB_R4_C01</incoming>
            <outgoing>TB_R4_C02</outgoing>
            <outgoing>TB_R4_C03</outgoing>
         </exclusiveGateway>
         <task completionQuantity="1" id="TB_R4_RecordRecoveryCase" isForCompensation="false" name="Create/update IO recovery case" startQuantity="1">
            <documentation id="sid-a0cc5684-0158-49ba-b692-e64e44ff46d4">[R4] Assign each discrepancy to IO, link its part/case, physical location or last known location, actor and timestamp, and record the recovery action. Carry unresolved cases forward visibly. Qualifying missed/misplaced items follow the existing urgent-tray/on-call recovery route; case recording does not mean recovery is complete.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_R4_C02</incoming>
            <outgoing>TB_R4_C04</outgoing>
         </task>
         <exclusiveGateway gatewayDirection="Converging" id="TB_R4_RecoveryCaseMerge">
            <documentation id="sid-a52f7a1b-b34f-4518-81bd-f575da11da33">[R4] Continue daily review after discrepancies have an owner and tracked recovery action; do not wait here for all external repairs to return.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
            </extensionElements>
            <incoming>TB_R4_C03</incoming>
            <incoming>TB_R4_C04</incoming>
            <outgoing>TB_R4_C05</outgoing>
         </exclusiveGateway>
