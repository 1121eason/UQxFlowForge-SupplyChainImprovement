            <outgoing>TB_F_TB_OOH_TB_Accept</outgoing>
         </task>
         <exclusiveGateway gatewayDirection="Diverging" id="TB_Accept" name="Accept request?">
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-55.0" y="-58.0"/>
            </extensionElements>
            <incoming>TB_F_TB_OOH_TB_Accept</incoming>
            <outgoing>TB_F_TB_Accept_TB_Decline</outgoing>
            <outgoing>TB_F_TB_Accept_TB_HoursJoin</outgoing>
         </exclusiveGateway>
         <exclusiveGateway gatewayDirection="Converging" id="TB_HoursJoin">
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
            </extensionElements>
            <incoming>TB_F_TB_Hours_TB_HoursJoin</incoming>
            <incoming>TB_F_TB_Accept_TB_HoursJoin</incoming>
            <outgoing>TB_F_TB_HoursJoin_TB_Authority</outgoing>
         </exclusiveGateway>
         <exclusiveGateway gatewayDirection="Diverging" id="TB_Authority" name="Agreed electronic authority?">
            <documentation id="sid-224cf35a-898b-4dda-95db-950c50dae15a">Only an agreed authoritative electronic record may bypass the legacy duplicate-document wait. Until PrimeTech agreement exists, retain the mail/PDF matching dependency and required evidence. This is a proposed agreement, not a claim of an existing portal/API.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-55.0" y="-58.0"/>
            </extensionElements>
            <incoming>TB_F_TB_HoursJoin_TB_Authority</incoming>
            <outgoing>TB_F_TB_Authority_TB_LegacyEmail</outgoing>
            <outgoing>TB_F_TB_Authority_TB_IntakeJoin</outgoing>
         </exclusiveGateway>
         <intermediateCatchEvent id="TB_LegacyEmail" name="Legacy email received">
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-60.0" y="39.0"/>
            </extensionElements>
            <incoming>TB_F_TB_Authority_TB_LegacyEmail</incoming>
            <outgoing>TB_F_TB_LegacyEmail_TB_Match</outgoing>
            <messageEventDefinition id="sid-2f4fda92-6df9-412b-91c4-2b86fbbb1ff4" messageRef="FFR_237d519d53aa5b23a0c94cc0701a1dbe"/>
         </intermediateCatchEvent>
         <task completionQuantity="1" id="TB_Match" isForCompensation="false" name="Match mail / PDF evidence [R6]" startQuantity="1">
            <documentation id="sid-2e75f273-b5cd-4067-bd7a-a9d6c249fc8b">Match the mailed request and corresponding PDF/email using CRN, purchase order and work/line-order references; retain required paper evidence and attachments.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_TB_LegacyEmail_TB_Match</incoming>
            <outgoing>TB_F_TB_Match_TB_IntakeJoin</outgoing>
         </task>
         <exclusiveGateway gatewayDirection="Converging" id="TB_IntakeJoin">
