         </task>
         <task completionQuantity="1" id="FFR_585078251cb4599fba176bbacf066ef0" isForCompensation="false" name="Add to part's record" startQuantity="1">
            <documentation id="sid-f2a7c646-a679-4160-9108-d7882f6623f3">IO links a newly created part ID to the returned-part record before the common history, notes and technician-confirmation steps. Case p.5.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>FFR_d565cf24d6105e289505f11538a11b46</incoming>
            <outgoing>FFR_b96b970ef85d57878a5038519867ef97</outgoing>
         </task>
         <exclusiveGateway gatewayDirection="Converging" id="FFR_403edd4611a25befbe1a182e2de83fcb">
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
            </extensionElements>
            <incoming>FFR_b96b970ef85d57878a5038519867ef97</incoming>
            <incoming>FFR_7cf3c9f5c7415bd8b7db9d30d0feeba6</incoming>
            <outgoing>FFR_96e97f195e6b56ef918ef4f045bb6c2c</outgoing>
         </exclusiveGateway>
         <exclusiveGateway gatewayDirection="Diverging" id="TB_R4_IdentityCaptureAvailable" name="Digital capture available?">
            <documentation id="sid-94441402-1f0a-4f10-94d6-1b10b94335c5">[R4] Device, readable label and record access are usable for controlled identity/location capture. A failure requires controlled manual capture followed by digital reconciliation.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-55.0" y="-58.0"/>
            </extensionElements>
            <incoming>FFR_96e97f195e6b56ef918ef4f045bb6c2c</incoming>
            <outgoing>TB_R4_I01</outgoing>
            <outgoing>TB_R4_I02</outgoing>
         </exclusiveGateway>
         <task completionQuantity="1" id="FFR_0c6ee9175bf85e31a0330c3b394dcbc8" isForCompensation="false" name="Link part ID and return history digitally" startQuantity="1">
            <documentation id="sid-7503ab7f-05e4-4c58-bcef-488351d0f1b5">[R4] IO links the confirmed internal part ID to the existing return, prior repair history and current location, recording case, actor and timestamp. Replace the handwritten note; do not invent a second identity for a part with an existing ID.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_R4_I01</incoming>
            <outgoing>TB_R4_I05</outgoing>
         </task>
         <task completionQuantity="1" id="TB_R4_ManualIdentityCapture" isForCompensation="false" name="Capture ID/history in controlled manual record" startQuantity="1">
            <documentation id="sid-0808d6da-0430-4a81-8714-862736eb9c11">[R4] IO records part ID/serial, current location, case, actor and timestamp using the approved manual fallback when a device, label or system is unavailable. Preserve the source event and flag it for reconciliation; do not create a second return or part identity.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_R4_I02</incoming>
            <outgoing>TB_R4_I03</outgoing>
         </task>
         <task completionQuantity="1" id="TB_R4_ReconcileIdentityCapture" isForCompensation="false" name="Reconcile manual capture digitally" startQuantity="1">
            <documentation id="sid-e5f99f56-35f5-474a-89ea-43ede74c31b4">[R4] IO repairs label/device access as required and reconciles the controlled manual capture to the same part and case, retaining actor, timestamp and correction history. Keep an IO-owned exception open until the digital ID/history linkage is correct.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_R4_I03</incoming>
            <outgoing>TB_R4_I04</outgoing>
         </task>
         <exclusiveGateway gatewayDirection="Converging" id="TB_R4_IdentityCaptureMerge">
            <documentation id="sid-c0e8c1e2-d8ec-4ead-9a73-f9e77bc93bbb">[R4] Either verified digital linkage or reconciled manual linkage continues to the retained technician follow-up.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
            </extensionElements>
            <incoming>TB_R4_I04</incoming>
            <incoming>TB_R4_I05</incoming>
            <outgoing>FFR_4445d39337a6524982428bf5ed7b10ef</outgoing>
         </exclusiveGateway>
         <task completionQuantity="1" id="FFR_6378ab63fe9757be9067e4c1914431f8" isForCompensation="false" name="Create technician quality follow-up" startQuantity="1">
            <documentation id="sid-b208d13f-fa49-404d-9df0-b920e7c6dffc">[R2, R4] IO creates a tracked digital technician follow-up linked to the part ID and return/repair history. Retain the technician quality check with an accountable assignee and visible status; historical-ID absence alone is not a quality defect.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>FFR_4445d39337a6524982428bf5ed7b10ef</incoming>
            <outgoing>FFR_4dd2d60e5e0e5350b898db5e398802d1</outgoing>
         </task>
         <task completionQuantity="1" id="FFR_00e69fda088b56c0a31b72d89e803b1c" isForCompensation="false" name="Confirm correct part with technician" startQuantity="1">
            <documentation id="sid-cc0307c9-16e0-4504-bbff-db690cc3767d">Use the noted ID to follow up with the technicians who repaired the part and confirm that the correct part was repaired. Applies to existing IDs and newly created IDs. Case p.5.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>FFR_4dd2d60e5e0e5350b898db5e398802d1</incoming>
            <outgoing>FFR_61f00f4da53c5976952a49bfcee64ad6</outgoing>
         </task>
         <endEvent id="FFR_91351ad28b175c138fbef81b6741887a" name="Part tracking completed">
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-60.0" y="39.0"/>
            </extensionElements>
            <incoming>FFR_61f00f4da53c5976952a49bfcee64ad6</incoming>
         </endEvent>
