      <subProcess completionQuantity="1" id="FFR_c8236c488b1a568090b2f2745c04cf14" isForCompensation="false" name="T4 | Controlled dispatch and reporting [R1 R4]" startQuantity="1" triggeredByEvent="false">
         <documentation id="sid-e45dbaaf-a198-4c2c-95d6-92173d7ac4ed">T4 / R1 R4. Entry is one physically available part with an explicit route: Spare, Internal, Interstate, or Rejected. Internal enters only after the parent workshop-repair subprocess has completed. The parent selects the route; this subprocess exclusively selects its corresponding preparation and actual handover. Mandatory manifest and dispatch note are affixed before handover, an explicit TO-BE resequencing. Customer shipments keep the applicable 3pm window; interstate handover is after 3pm; rejected physical parts return that day without an invented fixed dispatch time. Carrier consignment booking remains manual. A printed label is never evidence of dispatch. The completing IM or IO captures the actual handover once; outputs reuse that event. Output/data failures retain controlled manual evidence, an IM-owned output exception, IO-owned reconciliation, and unresolved carry-over. Interstate state is Sent to subcontractor, never repair complete. Daily closure is handled independently in the main process.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
            <signavio:signavioLabel bold="" fill="" fontFamily="" fontSize="12.0" italic="" ref="text_name"/>
            <signavio:signavioDiagramMetaData metaKey="revisionid" metaValue="f6abbd1ade904b9eb1a4298461d350ff"/>
         </extensionElements>
         <incoming>TB_F_SG_DispatchJoin_FFR_c8236c488b1a568090b2f2745c04cf14</incoming>
         <outgoing>TB_F_FFR_c8236c488b1a568090b2f2745c04cf14_SG_RequestDone</outgoing>
         <laneSet id="sid-d397bb0e-eb91-4eca-85d4-39c0196a357f" name="T4 | Controlled dispatch and reporting [R1 R4]">
            <lane id="TB_LS_FFR_c8236c488b1a568090b2f2745c04cf14_0" name="Inventory Manager">
               <extensionElements>
                  <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
                  <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
                  <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
               </extensionElements>
               <flowNodeRef>TB_DispatchStart</flowNodeRef>
               <flowNodeRef>TB_DispatchRoute</flowNodeRef>
               <flowNodeRef>FFR_92e791faf7b451378da5e07aff47139a</flowNodeRef>
               <flowNodeRef>FFR_77ff43e21c5355f68a02df8d329c2e1a</flowNodeRef>
               <flowNodeRef>TB_WorkSlot</flowNodeRef>
               <flowNodeRef>TB_WorkHandover</flowNodeRef>
               <flowNodeRef>TB_InterDocs</flowNodeRef>
               <flowNodeRef>TB_After3</flowNodeRef>
               <flowNodeRef>TB_InterHandover</flowNodeRef>
               <flowNodeRef>FFR_a2e56cbd9c7a58d598e311a05fb0ed57</flowNodeRef>
               <flowNodeRef>TB_HandoverJoin</flowNodeRef>
               <flowNodeRef>TB_OutputOK</flowNodeRef>
               <flowNodeRef>TB_Logged</flowNodeRef>
               <flowNodeRef>TB_OutputFailure</flowNodeRef>
               <flowNodeRef>TB_OutputOpen</flowNodeRef>
            </lane>
            <lane id="TB_LS_FFR_c8236c488b1a568090b2f2745c04cf14_1" name="Inventory Officer">
               <extensionElements>
                  <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
                  <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
                  <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
               </extensionElements>
               <flowNodeRef>FFR_1309fff0c9bf5c02897d342df1699252</flowNodeRef>
               <flowNodeRef>FFR_2ee66bc6466251dcaf7aa88c915678f4</flowNodeRef>
               <flowNodeRef>FFR_cd7c31b0dc725f298028976569d0e11b</flowNodeRef>
               <flowNodeRef>TB_DispatchDataReconcile</flowNodeRef>
            </lane>
            <lane id="TB_LS_FFR_c8236c488b1a568090b2f2745c04cf14_2" name="Inventory Manager / Inventory Officer">
               <extensionElements>
                  <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
                  <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
                  <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
               </extensionElements>
               <flowNodeRef>TB_Capture</flowNodeRef>
            </lane>
            <lane id="TB_LS_FFR_c8236c488b1a568090b2f2745c04cf14_3" name="System">
               <extensionElements>
                  <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
                  <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
                  <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
               </extensionElements>
               <flowNodeRef>TB_Outputs</flowNodeRef>
            </lane>
         </laneSet>
         <startEvent id="TB_DispatchStart" isInterrupting="true" name="Route selected; part available">
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-30.0" y="39.0"/>
            </extensionElements>
            <outgoing>TB_F_TB_DispatchStart_TB_DispatchRoute</outgoing>
         </startEvent>
         <exclusiveGateway gatewayDirection="Diverging" id="TB_DispatchRoute" name="Selected dispatch route?">
            <documentation id="sid-3310ef86-b762-49c2-a95f-ebb94d1e5762">Exclusive route selection from the parent outcome. Spare and Internal (after completed workshop repair) use customer preparation; Interstate and Rejected use their distinct preparation and actual physical handover.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-55.0" y="-58.0"/>
            </extensionElements>
            <incoming>TB_F_TB_DispatchStart_TB_DispatchRoute</incoming>
            <outgoing>TB_F_TB_DispatchRoute_FFR_92e791faf7b451378da5e07aff47139a</outgoing>
            <outgoing>TB_F_TB_DispatchRoute_TB_InterDocs</outgoing>
            <outgoing>TB_F_TB_DispatchRoute_FFR_a2e56cbd9c7a58d598e311a05fb0ed57</outgoing>
         </exclusiveGateway>
         <manualTask completionQuantity="1" id="FFR_92e791faf7b451378da5e07aff47139a" isForCompensation="false" name="Get ShipFast consignment manually" startQuantity="1">
            <documentation id="sid-5722e5e2-f7ec-461c-a278-6c86e28d1202">Inventory Manager manually obtains the shipping consignment number from ShipFast. No authorised carrier integration has been demonstrated. Spare verification/reservation or internal repair completion has already occurred in the appropriate parent route.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_TB_DispatchRoute_FFR_92e791faf7b451378da5e07aff47139a</incoming>
            <outgoing>TB_F_FFR_92e791faf7b451378da5e07aff47139a_FFR_77ff43e21c5355f68a02df8d329c2e1a</outgoing>
         </manualTask>
         <task completionQuantity="1" id="FFR_77ff43e21c5355f68a02df8d329c2e1a" isForCompensation="false" name="Print label; affix manifest / note [R1]" startQuantity="1">
            <documentation id="sid-666c4a5d-8433-42dc-9c0e-50ea578e6f97">Print the shipping ticket/label. Confirm the correct part, CRN and consignment; print and affix the mandatory Manifest and Dispatch note before handover. Ready for dispatch remains distinct from repair complete and from actual Dispatched. Preserve the spare reservation until actual handover.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_FFR_92e791faf7b451378da5e07aff47139a_FFR_77ff43e21c5355f68a02df8d329c2e1a</incoming>
            <outgoing>TB_F_FFR_77ff43e21c5355f68a02df8d329c2e1a_TB_WorkSlot</outgoing>
         </task>
         <intermediateCatchEvent id="TB_WorkSlot" name="Applicable 3pm dispatch slot">
            <documentation id="sid-ea2a2e1f-dff0-47d9-9c97-0ce87306093e">Preserve the applicable 3pm dispatch rule for working spares and internally repaired parts. Late-ready work uses the next applicable working-day slot; that is a disclosed modelling interpretation, not a promise of same-day completion.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-60.0" y="39.0"/>
            </extensionElements>
            <incoming>TB_F_FFR_77ff43e21c5355f68a02df8d329c2e1a_TB_WorkSlot</incoming>
            <outgoing>TB_F_TB_WorkSlot_TB_WorkHandover</outgoing>
            <timerEventDefinition id="sid-ea13c362-318f-479c-866f-80a7e533554c">
               <timeDate id="sid-56263d93-1020-4c93-90bc-563f26ca49a8" xsi:type="tFormalExpression">nextApplicableWorkingDayAt15</timeDate>
            </timerEventDefinition>
         </intermediateCatchEvent>
         <sendTask completionQuantity="1" id="TB_WorkHandover" implementation="##unspecified" isForCompensation="false" name="Hand over working / repaired part" startQuantity="1">
            <documentation id="sid-01e0cace-999c-4e21-80c3-aa523924c3ab">Actual physical customer handover to PrimeTech using ShipFast as applicable. Preserve whether the part was a working spare or an internally repaired part. State becomes Dispatched only from this actual event, never when the label is printed.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_TB_WorkSlot_TB_WorkHandover</incoming>
            <outgoing>TB_F_TB_WorkHandover_TB_HandoverJoin</outgoing>
         </sendTask>
         <task completionQuantity="1" id="TB_InterDocs" isForCompensation="false" name="Prepare subcontractor ticket / docs [R1]" startQuantity="1">
            <documentation id="sid-7e1789d1-013e-41a9-b020-33701157257f">Prepare the subcontractor ticket, consignment identity and required physical Manifest / Dispatch note before handover. Do not infer a completed repair or a customer shipment.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_TB_DispatchRoute_TB_InterDocs</incoming>
            <outgoing>TB_F_TB_InterDocs_TB_After3</outgoing>
         </task>
         <intermediateCatchEvent id="TB_After3" name="Applicable after-3pm slot">
            <documentation id="sid-0d05e73f-3300-467b-9939-86b0339ea2c4">Interstate handover remains after 3pm. The provider internal repair and its completion time remain outside the described scope.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-60.0" y="39.0"/>
            </extensionElements>
            <incoming>TB_F_TB_InterDocs_TB_After3</incoming>
            <outgoing>TB_F_TB_After3_TB_InterHandover</outgoing>
            <timerEventDefinition id="sid-ba4a9d79-6175-4d32-bfca-148a8f14caa5">
               <timeDate id="sid-fb6fc486-1e22-4067-b1b2-6971736f3ed5" xsi:type="tFormalExpression">nextApplicableWorkingDayAfter15</timeDate>
            </timerEventDefinition>
         </intermediateCatchEvent>
         <sendTask completionQuantity="1" id="TB_InterHandover" implementation="##unspecified" isForCompensation="false" name="Hand over to interstate subcontractor" startQuantity="1">
            <documentation id="sid-55174a4d-c0d1-439d-b494-6c0546e941fc">Actual physical handover to the interstate subcontractor. Result is Sent to subcontractor. It is not repair complete, customer Dispatched or a finalised repair case.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_TB_After3_TB_InterHandover</incoming>
            <outgoing>TB_F_TB_InterHandover_TB_HandoverJoin</outgoing>
         </sendTask>
         <task completionQuantity="1" id="FFR_a2e56cbd9c7a58d598e311a05fb0ed57" isForCompensation="false" name="Record physical part as Rejected" startQuantity="1">
            <documentation id="sid-7a7694bd-4945-478e-a958-67b374e77862">Inventory Manager records the out-of-scope physical part as Rejected. This route is only for a part actually received. A declined request without a physical part ends in the parent instead.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_TB_DispatchRoute_FFR_a2e56cbd9c7a58d598e311a05fb0ed57</incoming>
            <outgoing>TB_F_FFR_a2e56cbd9c7a58d598e311a05fb0ed57_FFR_1309fff0c9bf5c02897d342df1699252</outgoing>
         </task>
         <exclusiveGateway gatewayDirection="Converging" id="TB_HandoverJoin">
            <documentation id="sid-610d6648-b5aa-477f-9029-f37a6845bab2">Merge mutually exclusive actual handover routes.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
            </extensionElements>
            <incoming>TB_F_TB_WorkHandover_TB_HandoverJoin</incoming>
            <incoming>TB_F_TB_InterHandover_TB_HandoverJoin</incoming>
            <incoming>TB_F_FFR_cd7c31b0dc725f298028976569d0e11b_TB_HandoverJoin</incoming>
            <outgoing>TB_F_TB_HandoverJoin_TB_Capture</outgoing>
         </exclusiveGateway>
         <exclusiveGateway gatewayDirection="Diverging" id="TB_OutputOK" name="Capture / outputs complete?">
            <documentation id="sid-0804e159-a88a-4181-a69c-f3b1ee83348a">Success requires a complete actual-handover event and all required outputs. Missing/invalid capture, unavailable output generation or incomplete required postings take the No route.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-55.0" y="-58.0"/>
            </extensionElements>
            <incoming>TB_F_TB_Outputs_TB_OutputOK</incoming>
            <outgoing>TB_F_TB_OutputOK_TB_Logged</outgoing>
            <outgoing>TB_F_TB_OutputOK_TB_OutputFailure</outgoing>
         </exclusiveGateway>
         <endEvent id="TB_Logged" name="Handover logged; route state retained">
            <documentation id="sid-947cf981-92ee-48d4-9da8-0338c2ec16b7">Only the appropriate shipment/return handover is logged. Interstate repair remains outstanding and tracked independently.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-60.0" y="39.0"/>
            </extensionElements>
            <incoming>TB_F_TB_OutputOK_TB_Logged</incoming>
         </endEvent>
         <task completionQuantity="1" id="TB_OutputFailure" isForCompensation="false" name="Keep manual evidence; IM owns output exception [R1]" startQuantity="1">
            <documentation id="sid-2023a43a-26ea-44b8-b33c-bb19dce5ad55">Preserve controlled manual actual-handover evidence with mandatory references, timestamp and actor. IM owns failed-output recovery. Assign exception ID, owner and target date; do not re-dispatch the part or silently mark failed outputs complete.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_TB_OutputOK_TB_OutputFailure</incoming>
            <outgoing>TB_F_TB_OutputFailure_TB_DispatchDataReconcile</outgoing>
         </task>
         <endEvent id="TB_OutputOpen" name="Handover retained; exceptions tracked">
            <documentation id="sid-23d6aa19-342a-41c8-b5e9-4bd9fe3b7d54">The physical handover stands. Any unresolved capture, data or output exception carries forward; this is not a fictitious repair completion or an unqualified success state.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-60.0" y="39.0"/>
            </extensionElements>
            <incoming>TB_F_TB_DispatchDataReconcile_TB_OutputOpen</incoming>
         </endEvent>
         <task completionQuantity="1" id="FFR_1309fff0c9bf5c02897d342df1699252" isForCompensation="false" name="Create special shipping label" startQuantity="1">
            <documentation id="sid-d260401e-a18f-46ea-afad-990f55f6f6d2">Inventory Officer creates the required special shipping label for the irrelevant physical part. Retain the applicable consignment identity.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_FFR_a2e56cbd9c7a58d598e311a05fb0ed57_FFR_1309fff0c9bf5c02897d342df1699252</incoming>
            <outgoing>TB_F_FFR_1309fff0c9bf5c02897d342df1699252_FFR_2ee66bc6466251dcaf7aa88c915678f4</outgoing>
         </task>
         <task completionQuantity="1" id="FFR_2ee66bc6466251dcaf7aa88c915678f4" isForCompensation="false" name="Affix standard note / dispatch docs [R1]" startQuantity="1">
            <documentation id="sid-e4ce0801-df43-46e2-9c18-bba978109e34">Inventory Officer attaches the standard explanation note, special label, mandatory Manifest and Dispatch note before actual return. The same-day return requirement is retained; no fixed return time is stated in the source case.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_FFR_1309fff0c9bf5c02897d342df1699252_FFR_2ee66bc6466251dcaf7aa88c915678f4</incoming>
            <outgoing>TB_F_FFR_2ee66bc6466251dcaf7aa88c915678f4_FFR_cd7c31b0dc725f298028976569d0e11b</outgoing>
         </task>
         <sendTask completionQuantity="1" id="FFR_cd7c31b0dc725f298028976569d0e11b" implementation="##unspecified" isForCompensation="false" name="Return rejected physical part that day" startQuantity="1">
            <documentation id="sid-313a3b15-4f15-4417-bc99-5f02b87ec75c">Inventory Officer actually hands over the rejected physical part for PrimeTech that day. Record route state Rejected and the actual return handover; never fabricate a shipment for a request-only decline.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_FFR_2ee66bc6466251dcaf7aa88c915678f4_FFR_cd7c31b0dc725f298028976569d0e11b</incoming>
            <outgoing>TB_F_FFR_cd7c31b0dc725f298028976569d0e11b_TB_HandoverJoin</outgoing>
         </sendTask>
         <task completionQuantity="1" id="TB_DispatchDataReconcile" isForCompensation="false" name="Reconcile data; retain open carry-over [R4]" startQuantity="1">
            <documentation id="sid-bd055b51-b2a6-4948-806e-f267aa245a8a">IO owns data/part/location discrepancy reconciliation and corrects authoritative event data with history. IM retains output recovery ownership. Verify mandatory outputs when recovered; retain unresolved exceptions with owner and date for daily control. Closing the warehouse does not close an unresolved exception or a subcontracted repair.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_TB_OutputFailure_TB_DispatchDataReconcile</incoming>
            <outgoing>TB_F_TB_DispatchDataReconcile_TB_OutputOpen</outgoing>
         </task>
         <task completionQuantity="1" id="TB_Capture" isForCompensation="false" name="Capture handover once (IM / IO) [R1 R4]" startQuantity="1">
            <documentation id="sid-887d24f1-2c59-475e-8c44-f0266fb427e0">The role completing physical handover owns this single event: IM for working/repaired customer and interstate handover, IO for rejected physical returns. Capture CRN, serial/internal part ID, consignment, actual handover timestamp, actor, destination and selected route once. Preserve correction history, access control, part/location linkage and prior completion evidence. Customer route is Dispatched; interstate is Sent to subcontractor; rejected return remains Rejected. Device/label failure retains controlled contemporaneous manual evidence and is assessed as a capture/output failure below. Do not repeat a physical handover or mark an external repair complete.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_TB_HandoverJoin_TB_Capture</incoming>
            <outgoing>TB_F_TB_Capture_TB_Outputs</outgoing>
         </task>
         <serviceTask completionQuantity="1" id="TB_Outputs" implementation="##unspecified" isForCompensation="false" name="Generate Logistics / Tracking [R1]" startQuantity="1">
            <documentation id="sid-645cfa08-6b55-424a-bd95-cfb56d05b66e">Generate required Logistics Report, tracking spreadsheet and database outputs from the authoritative handover event. Eliminate parallel paper CRN retyping and duplicate human record entry. Proposed controlled data mapping is an improvement, not evidence of an existing API. Retain all required references, per-route state and correction history. If capture is invalid or unavailable, return failure without inventing a successful posting.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
