         <startEvent id="TB_T1Start" isInterrupting="true" name="Intake started">
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-30.0" y="39.0"/>
            </extensionElements>
            <outgoing>TB_F_TB_T1Start_TB_Correlate</outgoing>
         </startEvent>
         <task completionQuantity="1" id="TB_Correlate" isForCompensation="false" name="Link references; register receipt [R6]" startQuantity="1">
            <documentation id="sid-833b3a96-88e6-4874-a336-d26a2fd5d58e">R6 | I-04/I-01 | communication optimisation, automation. Preserve CRN, purchase order, work/line-order refs. Record actual receipt time and correlate resubmissions before creating another case. A structured pre-shipment request is allowed only under the proposed PrimeTech agreement; legacy mail remains valid.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_TB_T1Start_TB_Correlate</incoming>
            <outgoing>TB_F_TB_Correlate_TB_New</outgoing>
         </task>
         <exclusiveGateway gatewayDirection="Diverging" id="TB_New" name="New request?">
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-55.0" y="-58.0"/>
            </extensionElements>
            <incoming>TB_F_TB_Correlate_TB_New</incoming>
            <outgoing>TB_F_TB_New_TB_Duplicate</outgoing>
            <outgoing>TB_F_TB_New_TB_Hours</outgoing>
         </exclusiveGateway>
         <exclusiveGateway gatewayDirection="Diverging" id="TB_Hours" name="Received 8am-5pm?">
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-55.0" y="-58.0"/>
            </extensionElements>
            <incoming>TB_F_TB_New_TB_Hours</incoming>
            <outgoing>TB_F_TB_Hours_TB_HoursJoin</outgoing>
            <outgoing>TB_F_TB_Hours_TB_OOH</outgoing>
         </exclusiveGateway>
         <task completionQuantity="1" id="TB_OOH" isForCompensation="false" name="Review outside-hours acceptance" startQuantity="1">
            <documentation id="sid-79a27ad6-d1c1-458f-9800-fd1e76a4320c">Retain the case rule: requests received before 8am or after 5pm may be rejected at IM discretion. This is not an automatic rejection. Record the decision against actual receipt time.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
