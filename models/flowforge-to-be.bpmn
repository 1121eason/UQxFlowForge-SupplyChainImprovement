         </task>
         <task completionQuantity="1" id="FFR_6b19db2fa58f5dcd974eb059ea349266" isForCompensation="false" name="Diagnose fault [R3]" startQuantity="1">
            <documentation id="sid-ad98fa41-f791-462f-98f5-3e0042f3118e">Senior Technician: Identify cause of failure. Case p.4.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
