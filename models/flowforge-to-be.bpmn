         </task>
         <task completionQuantity="1" id="TB_R4_TechnicianCompletionCapture" isForCompensation="false" name="Capture completion and tray [R4]" startQuantity="1">
            <documentation id="sid-a4f4ece7-2401-4a56-86e1-0c15dbc873f7">R4 / I-03; automation and resource optimisation. The completing role records the correct part ID, request, physical Urgent repair tray location, passed technical outcome, actor and timestamp. Mark repair complete and readiness only; this is not an actual dispatch event. If the device, label or record update fails, retain controlled manual evidence and route the reconciliation exception to IO.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>FFR_cce969b3b08c5d7da8b85ad6ff2eea22</incoming>
            <outgoing>TB_R4_FlowTechCaptureToDecision</outgoing>
         </task>
         <exclusiveGateway gatewayDirection="Diverging" id="TB_R4_TechnicianCaptureDecision" name="Capture succeeded? [R4]">
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-55.0" y="-58.0"/>
            </extensionElements>
            <incoming>TB_R4_FlowTechCaptureToDecision</incoming>
            <outgoing>TB_R4_FlowTechCaptureSuccess</outgoing>
            <outgoing>TB_R4_FlowTechCaptureFailure</outgoing>
         </exclusiveGateway>
         <task completionQuantity="1" id="TB_R4_TechnicianManualCapture" isForCompensation="false" name="Record manual completion evidence [R4]" startQuantity="1">
            <documentation id="sid-f59672c6-a8cf-4c0c-95cd-1fa95fd02553">R4 fallback owned by the completing Technician. Record part ID, request, passed test evidence, tray location, actor and timestamp on the controlled manual record; assign an IO reconciliation exception. Do not repeat the repair, create a second receipt or record a fictitious dispatch.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_R4_FlowTechCaptureFailure</incoming>
            <outgoing>TB_R4_FlowTechManualToIOMerge</outgoing>
         </task>
         <task completionQuantity="1" id="FFR_38955d1c116c50a1b8f38c5061c8d4b1" isForCompensation="false" name="Escalate to senior technician" startQuantity="1">
            <documentation id="sid-c9a9551c-07d7-4795-ab6d-edd345f29831">Technician: Escalate to senior technician. Case p.4.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>FFR_f5d8e7a7fdb5568187ae1c99f4971d16</incoming>
            <outgoing>FFR_e7ebcd0d1b7b568a8f7a51bb51a8d7cf</outgoing>
         </task>
         <exclusiveGateway gatewayDirection="Converging" id="FFR_19aa2638a7695ba8b3e48491332eee26">
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
            </extensionElements>
            <incoming>TB_R4_FlowTechCaptureSuccess</incoming>
            <incoming>TB_R4_FlowSeniorCaptureSuccess</incoming>
