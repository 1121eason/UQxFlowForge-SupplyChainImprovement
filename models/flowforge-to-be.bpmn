            <documentation id="sid-ba05d567-2031-4055-baa0-c1564ed4f3c7">[R2] Choose recovery after correction.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
