            <outgoing>TB_F_TB_TypeList_TB_External</outgoing>
         </task>
         <exclusiveGateway gatewayDirection="Diverging" id="TB_External" name="Listed for interstate repair?">
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-55.0" y="-58.0"/>
            </extensionElements>
            <incoming>TB_F_TB_TypeList_TB_External</incoming>
            <outgoing>TB_F_TB_External_TB_InterJoin</outgoing>
            <outgoing>TB_F_TB_External_TB_Meet</outgoing>
         </exclusiveGateway>
         <task completionQuantity="1" id="TB_Meet" isForCompensation="false" name="Assess repair / priority with Technician" startQuantity="1">
            <documentation id="sid-cb4ce8ed-9f25-4d2e-bb17-abe739a4a39c">Preserve IM travel and repairability/priority discussion. No unsupported new disposal route or non-repairable frequency is introduced. A genuinely unresolved non-repairable case requires an owner disposition (report A4/A7). Senior retains authority over repair priorities and solutions.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_TB_External_TB_Meet</incoming>
            <outgoing>TB_F_TB_Meet_TB_T2SetInternal</outgoing>
         </task>
         <task completionQuantity="1" id="TB_T2SetInternal" isForCompensation="false" name="Set internal repair route" startQuantity="1">
            <documentation id="sid-1520befb-6408-46ce-8763-5b32607741cf">Set route=Internal following the existing repairability/priority discussion. Senior retains priority and solution authority. A genuinely unresolved non-repairable case requires owner disposition; no unsupported disposal route or frequency is invented. T3 completes repair and mandatory tests before T4 dispatch.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_TB_Meet_TB_T2SetInternal</incoming>
            <outgoing>TB_F_TB_T2SetInternal_TB_T2InternalEnd</outgoing>
         </task>
         <endEvent id="TB_T2InternalEnd" name="Internal repair selected">
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-60.0" y="39.0"/>
            </extensionElements>
            <incoming>TB_F_TB_T2SetInternal_TB_T2InternalEnd</incoming>
         </endEvent>
         <task completionQuantity="1" id="TB_SpareManual" isForCompensation="false" name="Manual evidence; assign IO follow-up [R4]" startQuantity="1">
            <documentation id="sid-5bb331ad-a703-44c1-a486-529eafc150f0">The completing IM retains controlled manual evidence if device/label/digital capture is unavailable. Assign an IO-owned reconciliation exception and preserve correct identity/location/reservation. No false digital completion or double allocation; do not omit required physical verification.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_TB_SpareCaptureOK_TB_SpareManual</incoming>
            <outgoing>TB_F_TB_SpareManual_TB_SpareCaptureJoin</outgoing>
         </task>
         <task completionQuantity="1" id="TB_T2SetSpare" isForCompensation="false" name="Set verified spare route" startQuantity="1">
            <documentation id="sid-24ccb377-50e2-4d2e-87b1-41551304ac6a">Set route=Spare after physical verification and reservation confirmation. T4 performs the consignment, ticket, Ready-for-dispatch documents, applicable 3pm window and actual handover.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_TB_SpareCaptureJoin_TB_T2SetSpare</incoming>
            <outgoing>TB_F_TB_T2SetSpare_TB_T2SpareEnd</outgoing>
         </task>
         <task completionQuantity="1" id="TB_Discrepancy" isForCompensation="false" name="Open IO stock discrepancy [R4 R5]" startQuantity="1">
            <documentation id="sid-be976148-5671-4d23-beb6-65dc4c686a46">Reserve against duplicate allocation; on shelf miss record part/location/case, actor and timestamp, release invalid reservation under control and retain IO-owned discrepancy for resolution. Route to the existing interstate recovery before creating an unusable spare ticket.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_FFR_ab76227e211b5303a3f4acd6f5895f4d_TB_Discrepancy</incoming>
            <outgoing>TB_F_TB_Discrepancy_TB_InterJoin</outgoing>
         </task>
         <exclusiveGateway gatewayDirection="Converging" id="TB_InterJoin">
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
            </extensionElements>
            <incoming>TB_F_TB_Discrepancy_TB_InterJoin</incoming>
            <incoming>TB_F_TB_External_TB_InterJoin</incoming>
            <outgoing>TB_F_TB_InterJoin_TB_T2SetInterstate</outgoing>
         </exclusiveGateway>
         <task completionQuantity="1" id="TB_T2SetInterstate" isForCompensation="false" name="Set interstate route" startQuantity="1">
            <documentation id="sid-07cf7b48-f55d-4410-a8e3-044ec85ee7fa">Set route=Interstate either for a listed relevant no-spare item or the preserved shelf-miss recovery. Keep any IO discrepancy open for resolution. T4 prepares the subcontractor documents and uses the applicable after-3pm handover slot; provider internal repair remains outside this process.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_TB_InterJoin_TB_T2SetInterstate</incoming>
            <outgoing>TB_F_TB_T2SetInterstate_TB_T2InterstateEnd</outgoing>
         </task>
         <endEvent id="TB_T2InterstateEnd" name="Interstate route selected">
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-60.0" y="39.0"/>
            </extensionElements>
            <incoming>TB_F_TB_T2SetInterstate_TB_T2InterstateEnd</incoming>
         </endEvent>
