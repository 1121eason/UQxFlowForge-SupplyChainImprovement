         <serviceTask completionQuantity="1" id="FFR_e6cdb61c341f5443bea9bcb85eb1fef8" implementation="##unspecified" isForCompensation="false" name="Generate audit/training output from verified receipt" startQuantity="1">
            <documentation id="sid-d201a235-1379-4bf1-aab6-f6137acfadeb">[R2] Proposed controlled automation maps the verified operational receipt to the required audit/training database. Preserve CRN, work order, serial, receipt date, source-event reference and actor/timestamp; use approved access permissions and an idempotent source-event key. Reuse data rather than re-entering or creating the operational receipt. Delivery failure is an explicit recoverable result.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_TB_R2_OutputAttemptMerge_FFR_e6cdb61c341f5443bea9bcb85eb1fef8</incoming>
            <outgoing>FFR_12c5404907635cd9998bed73bfe95c5b</outgoing>
         </serviceTask>
