      <subProcess completionQuantity="1" id="FFR_e2ccdc80932d5caf804b3f12170e1e39" isForCompensation="false" name="T1 | Validate intake [R6]" startQuantity="1" triggeredByEvent="false">
         <documentation id="sid-9495faf4-f87d-43ac-914c-559b55b357a9">T1 | R6 | I-04; supports I-01. Preserve the required CRN, purchase-order and work/line-order references, actual receipt time, discretionary outside-hours acceptance and legacy mail/PDF evidence. Use agreed electronic authority only after PrimeTech agreement. Correlate duplicate submissions and clarify uncertain scope before acceptance. Physical out-of-scope parts receive a recorded Reject outcome here and are returned through T4, with the original special-label/explanation controls. Outputs: intakeOutcome=Accepted, Rejected or No handover; physicalHandoverRequired=true only for an accepted physical part or an already-received rejected part. No dispatch occurs in this scope.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
            <signavio:signavioLabel bold="" fill="" fontFamily="" fontSize="12.0" italic="" ref="text_name"/>
            <signavio:signavioDiagramMetaData metaKey="revisionid" metaValue="792d491ca43f4109bc9f1732fb635bda"/>
         </extensionElements>
         <incoming>TB_F_SG_Request_FFR_e2ccdc80932d5caf804b3f12170e1e39</incoming>
         <outgoing>TB_F_FFR_e2ccdc80932d5caf804b3f12170e1e39_SG_IntakeOutcome</outgoing>
         <laneSet id="sid-a6cdc593-3de8-4b6d-9dcb-b04063ff2141" name="T1 | Validate intake [R6]">
            <lane id="TB_LS_FFR_e2ccdc80932d5caf804b3f12170e1e39_0" name="Inventory Manager">
               <extensionElements>
