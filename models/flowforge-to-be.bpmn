      <task completionQuantity="1" id="SG_DayReconcile" isForCompensation="false" name="Reconcile day; finalise resolved cases [R1 R4]" startQuantity="1">
         <documentation id="sid-245e40d6-eefb-467b-98c0-2f9a0b9c6e53">Select current-day postings and required dispatch/audit/manual-capture outputs. Reconcile completeness and corrections. Finalise only actually resolved cases with required controls complete. This composes the existing daily selection, reconciliation and resolved-case update; it does not invent an automatic status change. IM owns dispatch/output recovery, IO owns stock/data exceptions.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
            <signavio:signavioLabel bold="" fill="" fontFamily="" fontSize="12.0" italic="" ref="text_name"/>
         </extensionElements>
         <incoming>TB_F_SG_Close_SG_DayReconcile</incoming>
         <outgoing>TB_F_SG_DayReconcile_SG_Carry</outgoing>
      </task>
      <task completionQuantity="1" id="SG_Carry" isForCompensation="false" name="Assign open carry-over owners [R4]" startQuantity="1">
         <documentation id="sid-e5abaed2-b8ba-4ab3-bae8-3a29ebdd775d">Assign owners and dates to unresolved external repairs, missing outputs and capture discrepancies. Keep unresolved cases open; daily warehouse closure does not wait for multi-day repairs.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
            <signavio:signavioLabel bold="" fill="" fontFamily="" fontSize="12.0" italic="" ref="text_name"/>
         </extensionElements>
         <incoming>TB_F_SG_DayReconcile_SG_Carry</incoming>
         <outgoing>TB_F_SG_Carry_SG_CloseWarehouse</outgoing>
      </task>
