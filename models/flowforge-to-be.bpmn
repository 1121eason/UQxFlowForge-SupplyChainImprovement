         </exclusiveGateway>
         <endEvent id="FFR_35126dadbcea53bbb15e5f3b986a473c" name="Repaired part ready for daily dispatch">
            <documentation id="sid-96f5a921-77cb-45ea-91b6-cc1103446d32">The part passed the required technical tests and is in the correct tray. Its completion/location event is captured or reconciled from controlled manual evidence. Actual handover and dispatch reporting occur later in the existing request instance.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-60.0" y="39.0"/>
            </extensionElements>
            <incoming>FFR_4d430d1ea82456bd832460387d2de9fd</incoming>
         </endEvent>
         <task completionQuantity="1" id="TB_R3_ReviewDiagnosticEvidence" isForCompensation="false" name="Review Technician evidence [R3]" startQuantity="1">
            <documentation id="sid-e4eaa68a-f7ef-404f-84d7-eb26be87e4e7">R3 / I-02. The Senior checks completeness, relevance and reuse eligibility of the Technician's recorded tests, diagnosis, repair and rig result. The Senior retains priority and technical-disposition authority.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>FFR_e7ebcd0d1b7b568a8f7a51bb51a8d7cf</incoming>
            <outgoing>TB_R3_FlowReviewToDecision</outgoing>
         </task>
         <exclusiveGateway gatewayDirection="Diverging" id="TB_R3_ReusableEvidenceDecision" name="Evidence reusable? [R3]">
            <documentation id="sid-16c1cc7e-f0e4-4fcf-81eb-977f7084318b">Sufficient, relevant evidence permits targeted work. Otherwise the existing full component-test and diagnosis route remains. Both alternatives rejoin before Senior repair and the mandatory rig test.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-55.0" y="-58.0"/>
            </extensionElements>
            <incoming>TB_R3_FlowReviewToDecision</incoming>
            <outgoing>TB_R3_FlowTargetedEvidenceReuse</outgoing>
            <outgoing>TB_R3_FlowFullDiagnostics</outgoing>
         </exclusiveGateway>
         <task completionQuantity="1" id="FFR_6ef52e0ff83d5e54b8312e7d4318c917" isForCompensation="false" name="Perform full component tests [R3]" startQuantity="1">
            <documentation id="sid-444c3506-1533-4c9c-9e41-ee689381caef">Senior Technician: Perform component tests. Case p.4.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
