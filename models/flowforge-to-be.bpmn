         </task>
         <exclusiveGateway gatewayDirection="Diverging" id="FFR_510444fdf9055532a70d097307144a18" name="Test passed?">
            <documentation id="sid-02823622-6788-49a9-b805-91a241703e32">Senior rig test: pass leads to tray placement; failure leads once to rebuild and retest. The case's 30% conditional failure is a baseline, not a promised TO-BE performance rate. No unlimited loop.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-55.0" y="-58.0"/>
            </extensionElements>
            <incoming>FFR_893d66ffc568546fb80eea6cdd7af003</incoming>
            <outgoing>FFR_e1f33841c3c85b8090c203c42f4f4ab3</outgoing>
            <outgoing>FFR_b353222adb0353f18123fde1186056bb</outgoing>
         </exclusiveGateway>
         <task completionQuantity="1" id="FFR_5f8c63e2b6255f77ad1d09f4cc448c13" isForCompensation="false" name="Rebuild entire part" startQuantity="1">
            <documentation id="sid-1d318270-944a-47eb-bba4-540ca850dda7">Senior Technician: Rebuild entire part. Case p.4.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>FFR_b353222adb0353f18123fde1186056bb</incoming>
            <outgoing>FFR_8a713fe29f945b6892a5514d89a42bcd</outgoing>
         </task>
         <task completionQuantity="1" id="FFR_8b3de68d0c4851aa8eecd75e7a08d192" isForCompensation="false" name="Test rebuilt part" startQuantity="1">
            <documentation id="sid-e486eafe-7d79-4e09-84b6-a34556e612a5">Test the rebuilt part in the test rig. The case states that all rebuilt parts pass; no unsupported failure branch is introduced.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>FFR_8a713fe29f945b6892a5514d89a42bcd</incoming>
            <outgoing>FFR_c6d929f9fdb050e09789e57758a794c8</outgoing>
         </task>
