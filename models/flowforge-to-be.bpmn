         </exclusiveGateway>
         <task completionQuantity="1" id="TB_R2_VerifyDelivery" isForCompensation="false" name="Verify audit/training delivery" startQuantity="1">
            <documentation id="sid-dc8b3b3b-6d0b-4ee4-b921-adb34d8e9965">[R2] IO confirms the required output exists, matches the verified source receipt and retains provenance. Manual exception delivery must pass the same reconciliation; an attempted generation is not success.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_TB_R2_DeliveryCheckMerge_TB_R2_VerifyDelivery</incoming>
            <outgoing>TB_R2_F02</outgoing>
         </task>
         <exclusiveGateway gatewayDirection="Diverging" id="TB_R2_OutputDelivered" name="Required output delivered?">
            <documentation id="sid-40a0d570-fb74-497a-883c-efa07c19885a">[R2] Success requires a reconciled audit/training output. Failure remains IO-owned until corrected and verified.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-55.0" y="-58.0"/>
            </extensionElements>
            <incoming>TB_R2_F02</incoming>
            <outgoing>TB_R2_F03</outgoing>
            <outgoing>TB_R2_F04</outgoing>
         </exclusiveGateway>
         <task completionQuantity="1" id="TB_R2_RepairOutput" isForCompensation="false" name="Correct audit output exception" startQuantity="1">
            <documentation id="sid-ab8363e3-d6ae-4c76-87e9-fec140e3b243">[R2] IO records the exception and repairs the existing source/mapping, access or target-output issue as appropriate, preserving correction history. Reuse the same receipt/source-event key; do not register receipt again.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_R2_F04</incoming>
            <outgoing>TB_R2_F05</outgoing>
         </task>
         <exclusiveGateway gatewayDirection="Diverging" id="TB_R2_RetryPossible" name="Automated retry available?">
            <documentation id="sid-b2d98d5a-dc71-45de-808b-cd8c1a833161">[R2] IO chooses a safe automated retry after correction, or controlled manual delivery when automation is unavailable.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-55.0" y="-58.0"/>
            </extensionElements>
            <incoming>TB_R2_F05</incoming>
            <outgoing>TB_R2_F06</outgoing>
            <outgoing>TB_R2_F07</outgoing>
         </exclusiveGateway>
         <task completionQuantity="1" id="TB_R2_ManualOutput" isForCompensation="false" name="Deliver reconciled audit/training output manually" startQuantity="1">
            <documentation id="sid-7e765a3a-b320-4fbf-86bb-6bbacba2b993">[R2] IO fulfils the required audit/training output under the same permissions and source-event reference. This is an exception output, not a duplicate operational receipt. Record actor, time and correction history and verify reconciliation before closure.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_R2_F07</incoming>
            <outgoing>TB_R2_F08</outgoing>
         </task>
         <task completionQuantity="1" id="FFR_effcb45cd0695f74bd19ad1bfc3db70a" isForCompensation="false" name="Search part ID by serial number" startQuantity="1">
            <documentation id="sid-d8946c4c-e5e6-412f-942c-e26bd4ff9f4a">Inventory Officer: Search part ID by serial number. Case p.5.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
