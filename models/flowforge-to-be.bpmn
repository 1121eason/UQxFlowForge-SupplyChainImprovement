         </endEvent>
         <task completionQuantity="1" id="TB_Refer" isForCompensation="false" name="Place on Urgent tray; refer each item with deadline [R4]" startQuantity="1">
            <documentation id="sid-bd52b2fd-c9f5-4978-b501-d675c57cdbe2">Retain distinct on-call provider. For each qualifying item, capture part ID/location/CRN/actor/time; referral sets original handover + P1D nextNoticeAt. All referrals are issued without waiting for prior repairs. Keep separate pending identities and each original deadline. Device/label failure uses controlled manual evidence and IO-owned reconciliation; never suppress the physical referral.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
