         </exclusiveGateway>
         <task completionQuantity="1" id="FFR_949a5c757096501e8074597f7fd05389" isForCompensation="false" name="Repair component" startQuantity="1">
            <documentation id="sid-8e5a8f1e-05e4-4932-8399-35c16b7e18a7">R3 / I-02. Following the selected diagnostic route, the Senior repairs the component using verified diagnostic evidence, records the solution and retains priority authority. The same mandatory rig test follows targeted and full-diagnostic work. Case pp.4 and 6; report R3.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_R3_FlowSelectedDiagnosticsToRepair</incoming>
            <outgoing>FFR_25d86b82d523514e8587c00938da22b3</outgoing>
         </task>
         <task completionQuantity="1" id="FFR_a120df5aa3ee5874899739c00392e312" isForCompensation="false" name="Test part in test rig" startQuantity="1">
            <documentation id="sid-e5feb9e0-4120-4b92-b4a4-8a5c8d1e0447">Senior Technician: Test part in test rig. Case p.4.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
