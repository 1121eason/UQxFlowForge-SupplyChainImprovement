         <task completionQuantity="1" id="TB_R2_VerifyReceipt" isForCompensation="false" name="Verify receipt and required references" startQuantity="1">
            <documentation id="sid-8ebab224-6cdb-4c69-a220-a26376f2d443">[R2] IO checks the serial, CRN, work-order reference, receipt date and missing required details on the existing operational return. Correct this same receipt before generating the required output; initial capture is retained.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
