               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-55.0" y="-58.0"/>
            </extensionElements>
            <incoming>TB_F_TB_Search_TB_Route</incoming>
            <outgoing>TB_F_TB_Route_FFR_ff3ac572579250848e56d933f16d6c2f</outgoing>
            <outgoing>TB_F_TB_Route_TB_TypeList</outgoing>
         </exclusiveGateway>
         <task completionQuantity="1" id="FFR_ff3ac572579250848e56d933f16d6c2f" isForCompensation="false" name="Reserve spare [R5]" startQuantity="1">
            <documentation id="sid-d97f4234-1878-4765-9f7a-30bdbb166580">Allocate/reserve the identified spare against the accepted request to prevent double allocation. Keep the confirmed reservation until actual handover; control any release or invalidation. Courier booking and ticket generation occur only after physical verification, in T4.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_TB_Route_FFR_ff3ac572579250848e56d933f16d6c2f</incoming>
            <outgoing>TB_F_FFR_ff3ac572579250848e56d933f16d6c2f_FFR_b51d693e77c45aedaa3384fa0caa0bf1</outgoing>
         </task>
         <task completionQuantity="1" id="FFR_b51d693e77c45aedaa3384fa0caa0bf1" isForCompensation="false" name="Locate / verify shelf part [R5]" startQuantity="1">
            <documentation id="sid-5c9395fd-8289-4967-8627-0b200a30b6b5">IM checks the recorded warehouse shelf and physically verifies the identified spare before consignment or ticket creation. R5 resequences this original activity; it does not assume improved stock accuracy.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_FFR_ff3ac572579250848e56d933f16d6c2f_FFR_b51d693e77c45aedaa3384fa0caa0bf1</incoming>
            <outgoing>TB_F_FFR_b51d693e77c45aedaa3384fa0caa0bf1_FFR_ab76227e211b5303a3f4acd6f5895f4d</outgoing>
         </task>
         <exclusiveGateway gatewayDirection="Diverging" id="FFR_ab76227e211b5303a3f4acd6f5895f4d" name="On shelf?">
            <documentation id="sid-b16d3165-685f-4c44-9cc8-fa8cf40899f8">Yes requires the correct physical spare at the shelf. No opens a recorded IO-owned stock discrepancy and routes to the existing interstate recovery before any unusable spare output is produced. No child error event or detached dispatch is required.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-55.0" y="-58.0"/>
            </extensionElements>
            <incoming>TB_F_FFR_b51d693e77c45aedaa3384fa0caa0bf1_FFR_ab76227e211b5303a3f4acd6f5895f4d</incoming>
            <outgoing>TB_F_FFR_ab76227e211b5303a3f4acd6f5895f4d_FFR_a818b72098e7554a9aa0e60547cc076e</outgoing>
            <outgoing>TB_F_FFR_ab76227e211b5303a3f4acd6f5895f4d_TB_Discrepancy</outgoing>
         </exclusiveGateway>
         <task completionQuantity="1" id="FFR_a818b72098e7554a9aa0e60547cc076e" isForCompensation="false" name="Confirm part / location / reserve [R4 R5]" startQuantity="1">
            <documentation id="sid-dddf02a2-752e-4c71-ae4b-eec2417195aa">Confirm part identity, location and reservation. Capture CRN/part ID, location, actor and timestamp at verification. Keep the reservation valid against concurrent allocation until T4 handover. This is not a dispatch event.</documentation>
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
               <signavio:signavioLabel bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name"/>
            </extensionElements>
            <incoming>TB_F_FFR_ab76227e211b5303a3f4acd6f5895f4d_FFR_a818b72098e7554a9aa0e60547cc076e</incoming>
            <outgoing>TB_F_FFR_a818b72098e7554a9aa0e60547cc076e_TB_SpareCaptureOK</outgoing>
         </task>
         <exclusiveGateway gatewayDirection="Diverging" id="TB_SpareCaptureOK" name="Capture available? [R4]">
            <extensionElements>
               <signavio:signavioMetaData metaKey="bgcolor" metaValue="#eaf5fc"/>
               <signavio:signavioMetaData metaKey="bordercolor" metaValue="#176490"/>
