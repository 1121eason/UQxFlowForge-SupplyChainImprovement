      <dataObjectReference dataObjectRef="sid-2598541b-d4fa-4fbf-b616-adf373abd169" id="FFR_373984d7f1fb505e9bcac0240e913749" name="CRN / PO /&#10;WO refs">
         <documentation id="sid-cdaa01ba-d7fc-4a23-ae34-12a7b03ce255">Request references: Customer Reference Number (CRN), purchase order (PO), work order (WO) and work-order line. Use these references to match the postal request and subsequent email.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
            <signavio:signavioLabel align="left" ref="text_name" valign="top" x="11.25" y="45.0"/>
         </extensionElements>
      </dataObjectReference>
      <dataStoreReference dataStoreRef="sid-7f05c764-d37a-4478-9da3-05435b5a32f5" id="FFR_a40a27e1934e5bc7950b5dca1ea627f6" name="Shared drive">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
            <signavio:signavioLabel align="left" ref="text_name" x="-13.499500000000012" y="59.8365"/>
         </extensionElements>
      </dataStoreReference>
      <dataObjectReference dataObjectRef="sid-71d6e325-38d2-4469-98ea-6b7fd17571b2" id="FFR_4e64f240957c51d2a22ae131ed71d5b9" name="CRN">
         <documentation id="sid-f9540c2f-6b92-4f99-b064-c36c3593cd69">Paper CRN notepad used by the Inventory Manager after dispatch as a daily completeness check. CRN means Customer Reference Number. The Logistics Report records the item serial number and shipping consignment number in the following activity.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
            <signavio:signavioLabel align="left" ref="text_name" valign="top" x="49.5" y="0.0"/>
         </extensionElements>
      </dataObjectReference>
      <textAnnotation id="FFR_350929760af05c5ca517037aa0e4100a" signavio:alignment="left" textFormat="text/plain">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <text>TRIGGER SCOPE
Per request: one CRN / work-order-line case.
IO review and closing each start once per working day.
Shared records link cases; their sequence flows remain separate.</text>
      </textAnnotation>
      <textAnnotation id="FFR_904a9cee23ff5f2e9ab54d5f98e267b7" signavio:alignment="left" textFormat="text/plain">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <text>ASSUMPTIONS
SLA uses postal-request receipt time. Late-notified work carries forward.
Ready-after-3pm parts use the next dispatch slot.</text>
      </textAnnotation>
      <textAnnotation id="FFR_8247404300c9563bbdbb3e12361b1e8a" signavio:alignment="left" textFormat="text/plain">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <text>DAILY CLOSING
Today's signed-off batch.
Open / future-day work carries forward.</text>
      </textAnnotation>
      <textAnnotation id="FFR_4e6c7129afc35e2a970785d8fc6ae565" signavio:alignment="left" textFormat="text/plain">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <text>URGENT RECOVERY
Refer all missed items before waiting.
Only actual receipt permits dispatch and finalisation of that item.
Keep every remaining item and its original one-day deadline.
Assumption: repeat late notices daily; record each notified item's next due date.
A different item returning does not restart these deadlines.</text>
      </textAnnotation>
   </process>
