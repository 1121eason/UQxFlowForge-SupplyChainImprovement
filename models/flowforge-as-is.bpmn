      </subProcess>
      <task completionQuantity="1" id="FFR_b8470b3bc09a5a6e975e154b66140029" isForCompensation="false" name="Send late notice to PrimeTech" startQuantity="1">
         <documentation id="sid-5bdae464-c404-4929-8087-5e7c60d5c485">For all currently overdue, still-outstanding referrals in this daily review, send PrimeTech a late notice identifying the affected items. Record the notice and advance only those items nextNoticeAt to this notice time plus one day. Daily repetition is an explicit assumption because the case does not state a repeat cadence. Do not dispatch, finalise or remove an item because its deadline elapsed. Continue to the same event-based wait for actual receipt or the next absolute due date. Case p.5.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <incoming>FFR_5f66c8d13a5953cc89a518895d4cd2fd</incoming>
         <outgoing>FFR_ed8ca5e34fbd54e790b9c1dd1d6b1df2</outgoing>
      </task>
      <exclusiveGateway gatewayDirection="Diverging" id="FFR_eb8770fdd4575a2597f932a8ce908427" name="Missed/misplaced &#10; items found?">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
            <signavio:signavioLabel ref="text_name" x="-113.5" y="51.5"/>
         </extensionElements>
         <incoming>FFR_410e5673fb4f5e8ba441b35721e1c202</incoming>
         <outgoing>FFR_1fa8c02d5deb5279ba299ccd42a8b48a</outgoing>
         <outgoing>FFR_3f6bca36025656f3a4ec797770dc5fb6</outgoing>
      </exclusiveGateway>
      <exclusiveGateway gatewayDirection="Converging" id="FFR_ffff7d5cd70c5df289cf4ddd4f3ec301">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <incoming>FFR_3f6bca36025656f3a4ec797770dc5fb6</incoming>
         <incoming>FFR_9f25b1b01446576f82ff1ca1fd4212d1</incoming>
         <outgoing>FFR_cab0281d2e7b55eea745e451368c2188</outgoing>
      </exclusiveGateway>
      <startEvent id="FFR_41dc9d5ec91f591daaace94b38ae8985" isInterrupting="true" name="Once daily&#10;IO returns review">
         <documentation id="sid-3deb1a6e-7827-45cd-9d02-287cb8070918">Start one IO review per working day. Returns and tracking repeat over the previous-day record snapshot; warehouse inspection runs once. Outstanding urgent referrals retain their own deadlines until actual receipt, dispatch and finalisation.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
            <signavio:signavioLabel align="left" ref="text_name" x="-18.599999999999994" y="42.89999999999998"/>
         </extensionElements>
         <outgoing>FFR_98551bf14d1056519aba7408856ac198</outgoing>
         <timerEventDefinition id="sid-1798a0d7-6a02-41ae-9c14-46260f3a3725">
            <timeCycle id="sid-00d6e495-b2cc-4e23-ac0a-589085e6da88" xsi:type="tFormalExpression">eachWorkingDayAtDailyReturnsReview</timeCycle>
         </timerEventDefinition>
      </startEvent>
      <task completionQuantity="1" id="FFR_f2bc294a7fa158a4a2b69134be699599" isForCompensation="false" name="Finalise returned&#10;item request" startQuantity="1">
         <documentation id="sid-ca1e48c6-5fe5-453b-bd68-bd734d6974b4">After dispatch, mark only the physically returned current item request Finalised and remove that item from this review case outstanding set. Leave all other referred items Open. Case pp.5-6.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <incoming>FFR_2ac5c63123755de4b2b757e25ad789ea</incoming>
         <outgoing>FFR_daa3f2cb194f5e64a2fd449f876638e5</outgoing>
      </task>
      <exclusiveGateway gatewayDirection="Diverging" id="FFR_c2c387ff092d576e9a55a58b12b18c9d" name="Any items still&#10;outstanding?">
         <documentation id="sid-c9f800ee-13bd-42cb-b80c-79409bdb7a42">After the current returned item has been dispatched and finalised, check the remaining referred-item set. Yes returns to the common event wait with unchanged deadlines for other items; No completes the daily review.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
            <signavio:signavioLabel ref="text_name" x="-95.5" y="47.0"/>
         </extensionElements>
         <incoming>FFR_daa3f2cb194f5e64a2fd449f876638e5</incoming>
         <outgoing>FFR_54156d9e52815b5e83ced546bfb9ce8d</outgoing>
         <outgoing>FFR_9f25b1b01446576f82ff1ca1fd4212d1</outgoing>
      </exclusiveGateway>
      <subProcess completionQuantity="1" id="FFR_1c5bd209d935565895d080561a3132e1" isForCompensation="false" name="Repair and test part" startQuantity="1" triggeredByEvent="false">
         <documentation id="sid-a17c46e6-081b-48cd-ada8-c14d14791798">Per internally repaired request. Run technician/senior repair, leave its passed part in the Urgent repair tray, then continue in this same request instance to the applicable 3pm dispatch and common CRN/Logistics Report recording. Daily closing later corrects the resolved request status. Case pp.4-6.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
            <signavio:signavioDiagramMetaData metaKey="revisionid" metaValue="28102f2f986e45ea922f231642e7b647"/>
         </extensionElements>
         <incoming>FFR_2206e8785a6758c89af1f92d8fead330</incoming>
         <outgoing>FFR_8f2cb57358ff5f988b71bd6c429521d1</outgoing>
