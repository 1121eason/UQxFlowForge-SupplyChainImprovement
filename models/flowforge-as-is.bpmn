            <outgoing>FFR_f5d8e7a7fdb5568187ae1c99f4971d16</outgoing>
         </exclusiveGateway>
         <task completionQuantity="1" id="FFR_242fb171cd2a519f815ad41b43447300" isForCompensation="false" name="Test part in test rig" startQuantity="1">
            <documentation id="sid-d035b164-d328-4b99-bb9a-3d257e09b9eb">Technician: Test part in test rig. Case p.4.</documentation>
            <incoming>FFR_b4d617a2dcac51cc99392c7225e3f195</incoming>
            <outgoing>FFR_b2789ca6fc1459e1b50bfe2c2d2bb09b</outgoing>
