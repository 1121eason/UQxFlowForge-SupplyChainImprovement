         <task completionQuantity="1" id="FFR_a120df5aa3ee5874899739c00392e312" isForCompensation="false" name="Test part in test rig" startQuantity="1">
            <documentation id="sid-1eed1e95-1aa7-4fc3-8e6e-52ace075abc6">Senior Technician: Test part in test rig. Case p.4.</documentation>
            <incoming>FFR_25d86b82d523514e8587c00938da22b3</incoming>
            <outgoing>FFR_893d66ffc568546fb80eea6cdd7af003</outgoing>
         </task>
         <exclusiveGateway gatewayDirection="Diverging" id="FFR_510444fdf9055532a70d097307144a18" name="Test passed?">
            <documentation id="sid-fc400a85-1941-4ff0-afd3-28c683521b13">Senior rig test: pass versus fail; the case gives 30% failure among the senior attempts. A fail requires a complete rebuild and its guaranteed passing test. Case p.4.</documentation>
            <extensionElements>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-35.0" y="-55.0"/>
