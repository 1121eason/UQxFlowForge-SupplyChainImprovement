      <endEvent id="FFR_4be9b7f8f94453ee9f71f184b8dce9fd" name="Warehouse &#10;closed">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
            <signavio:signavioLabel align="left" ref="text_name" x="-36.60000000000002" y="47.39999999999998"/>
         </extensionElements>
         <incoming>FFR_82e9c38acc2650f38146f23d9976d404</incoming>
      </endEvent>
      <subProcess completionQuantity="1" id="FFR_c8236c488b1a568090b2f2745c04cf14" isForCompensation="false" name="Complete daily closing" startQuantity="1" triggeredByEvent="false">
         <documentation id="sid-3b7b8f43-316d-4c7e-8526-c01e050667ce">Once per daily closing review. Select the signed-off current-day work/consignment records, wait for corresponding Logistics Report entries and finished selected repairs, record/discuss urgent changes, manually finalise resolved requests, then prepare manifests, update tracking and close the warehouse. Empty sets are permitted. Unresolved external and future-slot work remain Open. Case pp.5-6.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
            <signavio:signavioDiagramMetaData metaKey="revisionid" metaValue="ea0708a6b79b415d9b2fb1f730061a28"/>
         </extensionElements>
         <incoming>FFR_a5faf9f548dd5141b297fb7c280da43f</incoming>
         <outgoing>FFR_82e9c38acc2650f38146f23d9976d404</outgoing>
         <laneSet id="sid-cb2b6d9c-101f-406f-ba80-4930914221ef" name="Complete daily closing">
            <lane id="FFR_ea080d14ab2856049aa929e5e4345c29" name="Inventory Manager">
               <flowNodeRef>FFR_b466de082a4c537e9b8f579cd928f2bd</flowNodeRef>
               <flowNodeRef>FFR_ce79379118e85433bd55fb3b92598636</flowNodeRef>
               <flowNodeRef>FFR_919e6a4d1e9151458e3025e49236c01f</flowNodeRef>
               <flowNodeRef>FFR_1e0d9d717bc6524bbcc274e0e539bc02</flowNodeRef>
               <flowNodeRef>FFR_05d5016e63de5626a1dfc4f5942d70d7</flowNodeRef>
               <flowNodeRef>FFR_2ea495e8bf035f929dd0e2c5951acab1</flowNodeRef>
               <flowNodeRef>FFR_f395d743c73c583fac471d90f9997f7f</flowNodeRef>
               <flowNodeRef>FFR_840dc2235d2c5d318fd88cb46374d585</flowNodeRef>
               <flowNodeRef>FFR_f59499a23f4e50b199effe470ac6aafa</flowNodeRef>
               <flowNodeRef>FFR_bc9d398d4768574db793ede8a2250599</flowNodeRef>
               <flowNodeRef>FFR_9e1a7d9ad7ce547f8f341a736baf0135</flowNodeRef>
               <flowNodeRef>FFR_238e339c65ba5ee09e612c1e8ed17be7</flowNodeRef>
               <flowNodeRef>FFR_3f454d05b3af51438b221306cb6ee989</flowNodeRef>
               <flowNodeRef>FFR_dbe359f8a29756fab7961d5e9a7e3dd6</flowNodeRef>
               <flowNodeRef>FFR_40b5ba6e124a5e56a0d993bc67897831</flowNodeRef>
            </lane>
         </laneSet>
         <task completionQuantity="1" id="FFR_b466de082a4c537e9b8f579cd928f2bd" isForCompensation="false" name="Mark resolved requests as Finalised" startQuantity="1">
            <documentation id="sid-f14b4480-2726-49cf-bb92-3a0b4629cca4">For each resolved request selected for this closing day, IM manually marks it Finalised. Unresolved interstate/on-call work and late-ready work remain Open. The set can be empty. Case pp.5-6.</documentation>
            <incoming>FFR_8682a3cb98ae51a7a195b2376c3096ca</incoming>
            <outgoing>FFR_76f4b20f3d3e5cc882b2f14fb3ae6f8a</outgoing>
            <multiInstanceLoopCharacteristics id="sid-c56101d7-b105-4da8-8a5a-f92e26289827" isSequential="true">
               <loopCardinality id="sid-aceb1a84-425d-4972-9266-6ef555981ed4">resolvedRequestCountForClosingDay</loopCardinality>
            </multiInstanceLoopCharacteristics>
         </task>
         <task completionQuantity="1" id="FFR_ce79379118e85433bd55fb3b92598636" isForCompensation="false" name="Print manifest and dispatch note" startQuantity="1">
            <documentation id="sid-3c2f9ca5-3c77-4f5d-9800-7cc2e070b014">For each current-day consignment, IM prints the Manifest and Dispatch note (1 minute). No consignment means no manifest to print. Per-consignment repetition is a modelling assumption. Case p.5.</documentation>
            <incoming>FFR_76f4b20f3d3e5cc882b2f14fb3ae6f8a</incoming>
            <outgoing>FFR_cbc7aa4795ef5d998f11e9775988afcc</outgoing>
            <multiInstanceLoopCharacteristics id="sid-db84871a-7993-41fc-8eeb-ccc73d5dbd87" isSequential="true">
               <loopCardinality id="sid-f8edbf5c-4866-4fad-8a90-46d974227dff">consignmentCountForClosingDay</loopCardinality>
            </multiInstanceLoopCharacteristics>
         </task>
         <task completionQuantity="1" id="FFR_919e6a4d1e9151458e3025e49236c01f" isForCompensation="false" name="Affix manifest to consignment box" startQuantity="1">
            <documentation id="sid-51d2e4a3-2c25-44f8-a86f-b1d3b2a477c9">For each current-day consignment, IM affixes the printed documents to the box (50 seconds). The source order, after dispatch/report review, is retained. Case p.5.</documentation>
            <incoming>FFR_cbc7aa4795ef5d998f11e9775988afcc</incoming>
            <outgoing>FFR_4dd3173273155098bfba2f5334ae5cfc</outgoing>
            <multiInstanceLoopCharacteristics id="sid-574dd7f9-a66a-4d5a-a01a-ceb4de9e3311" isSequential="true">
               <loopCardinality id="sid-c6e7472a-d726-4d90-bb93-736c2bcec6b4">consignmentCountForClosingDay</loopCardinality>
            </multiInstanceLoopCharacteristics>
         </task>
         <task completionQuantity="1" id="FFR_1e0d9d717bc6524bbcc274e0e539bc02" isForCompensation="false" name="Update tracking spreadsheet and database" startQuantity="1">
            <documentation id="sid-8be88655-e257-4076-b722-6bd3c3bce38c">For each shipped item in the daily register, IM records shipping date and consignment number in both the tracking spreadsheet and database (10 minutes). Case p.5.</documentation>
            <incoming>FFR_4dd3173273155098bfba2f5334ae5cfc</incoming>
            <outgoing>FFR_b8cbedfef435579498a0ad5992a4ebdd</outgoing>
            <multiInstanceLoopCharacteristics id="sid-62a1e018-b602-420e-89a2-455fbc0dcc35" isSequential="true">
               <loopCardinality id="sid-d4015b4d-41b5-4217-8cb1-0918d78e3be6">dispatchedItemCountForClosingDay</loopCardinality>
            </multiInstanceLoopCharacteristics>
         </task>
         <task completionQuantity="1" id="FFR_05d5016e63de5626a1dfc4f5942d70d7" isForCompensation="false" name="Close warehouse" startQuantity="1">
            <documentation id="sid-984709d5-c84c-4bc2-8db3-6d346336bf2e">IM closes the warehouse after daily dispatch and reporting are complete (30 minutes). Case p.5.</documentation>
            <incoming>FFR_b8cbedfef435579498a0ad5992a4ebdd</incoming>
            <outgoing>FFR_f10c5998fc3851d2aa67f9a41dcea87d</outgoing>
         </task>
         <startEvent id="FFR_2ea495e8bf035f929dd0e2c5951acab1" isInterrupting="true" name="Daily dispatch / closing scheduled">
            <extensionElements>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-35.0" y="65.0"/>
            </extensionElements>
            <outgoing>FFR_b30997186b68599888bb576306bf2a40</outgoing>
         </startEvent>
         <endEvent id="FFR_f395d743c73c583fac471d90f9997f7f" name="warehouse closed">
            <extensionElements>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-49.0" y="65.0"/>
            </extensionElements>
            <incoming>FFR_f10c5998fc3851d2aa67f9a41dcea87d</incoming>
         </endEvent>
         <task completionQuantity="1" id="FFR_840dc2235d2c5d318fd88cb46374d585" isForCompensation="false" name="Check urgent change requests" startQuantity="1">
            <documentation id="sid-43f7d59b-8a96-449f-890d-6ed76fb8c921">After 3pm and after the Logistics Report is updated, IM checks whether urgent change requests were received during repair activities.</documentation>
            <incoming>FFR_0ccc1c95d3815ba58e70cdb805199ce5</incoming>
            <outgoing>FFR_6114f8902be35e44967e1cdf5dfb067b</outgoing>
         </task>
         <exclusiveGateway gatewayDirection="Diverging" id="FFR_f59499a23f4e50b199effe470ac6aafa" name="Urgent changes received?">
            <extensionElements>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-30.0" y="-80.0"/>
            </extensionElements>
            <incoming>FFR_6114f8902be35e44967e1cdf5dfb067b</incoming>
            <outgoing>FFR_dcd55ea3dd375ae7b5695b55697ea03b</outgoing>
            <outgoing>FFR_8e107efeba785b65a5f9d72c24003246</outgoing>
         </exclusiveGateway>
         <task completionQuantity="1" id="FFR_bc9d398d4768574db793ede8a2250599" isForCompensation="false" name="Record urgent changes in database" startQuantity="1">
            <documentation id="sid-2d90c6c8-f764-4b6a-ba6c-6c0498460188">Inventory Manager: Record urgent changes in database. Case p.5.</documentation>
            <incoming>FFR_dcd55ea3dd375ae7b5695b55697ea03b</incoming>
            <outgoing>FFR_fd33064c0391586187d53a071358aa8b</outgoing>
         </task>
         <task completionQuantity="1" id="FFR_9e1a7d9ad7ce547f8f341a736baf0135" isForCompensation="false" name="Discuss repair priority with technician" startQuantity="1">
            <documentation id="sid-c33cb77d-f4ff-4e6d-9618-98ebd58075cd">IM discusses recorded urgent changes with the responsible technician/senior to reprioritise repair with the changed requirements. This updates the shared request record for open/current or carried-forward work; it does not undo a shipment already handed over. Case p.5.</documentation>
            <incoming>FFR_fd33064c0391586187d53a071358aa8b</incoming>
            <outgoing>FFR_ed1b1720e0d75956b48508c1e5e5afa1</outgoing>
         </task>
         <exclusiveGateway gatewayDirection="Converging" id="FFR_238e339c65ba5ee09e612c1e8ed17be7">
            <incoming>FFR_ed1b1720e0d75956b48508c1e5e5afa1</incoming>
            <incoming>FFR_8e107efeba785b65a5f9d72c24003246</incoming>
            <outgoing>FFR_77b8ea45293d5a7da98dade838f28675</outgoing>
         </exclusiveGateway>
         <intermediateCatchEvent id="FFR_3f454d05b3af51438b221306cb6ee989" name="Day dispatch register and report complete">
            <extensionElements>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-50.0" y="-95.0"/>
            </extensionElements>
            <incoming>FFR_521ee985e5225543818b3887ce8a0320</incoming>
            <outgoing>FFR_0ccc1c95d3815ba58e70cdb805199ce5</outgoing>
            <conditionalEventDefinition id="sid-2bf3a1f8-efe1-41d8-b264-ba5edf0f3df3">
               <condition id="sid-2995f296-fabb-4b15-ad62-76681b3b2ebd" xsi:type="tFormalExpression">The current-day dispatch register is closed and every selected consignment has a Logistics Report entry; true for an empty dispatch set</condition>
            </conditionalEventDefinition>
         </intermediateCatchEvent>
         <intermediateCatchEvent id="FFR_dbe359f8a29756fab7961d5e9a7e3dd6" name="Daily repair work completed">
            <extensionElements>
               <signavio:signavioLabel align="left" bold="" fill="" fontFamily="Arial" fontSize="12.0" italic="" ref="text_name" valign="top" x="-45.0" y="-85.0"/>
            </extensionElements>
            <incoming>FFR_77b8ea45293d5a7da98dade838f28675</incoming>
            <outgoing>FFR_8682a3cb98ae51a7a195b2376c3096ca</outgoing>
            <conditionalEventDefinition id="sid-4a2ff876-a6c4-4026-9b77-856fc08dbe6b">
               <condition id="sid-663bf387-afcc-4fa2-b632-69c4322d7265" xsi:type="tFormalExpression">All internal repair work assigned to the signed-off closing-day batch has finished; unresolved external and future-slot jobs carry forward</condition>
            </conditionalEventDefinition>
         </intermediateCatchEvent>
         <task completionQuantity="1" id="FFR_40b5ba6e124a5e56a0d993bc67897831" isForCompensation="false" name="Select current-day work records" startQuantity="1">
            <documentation id="sid-079fa21b-eb5d-48c7-862c-92841029a4e7">IM selects the current working-day dispatch register and assigned internal repair-work batch by dispatch day and CRN/work-order-line. Daily batch assumption: the booking window is signed off before closure; work assigned to a later slot and unresolved external repairs remain Open. The batch may be empty. This is a manual record review, not an automatic status synchronisation.</documentation>
            <incoming>FFR_b30997186b68599888bb576306bf2a40</incoming>
            <outgoing>FFR_521ee985e5225543818b3887ce8a0320</outgoing>
         </task>
         <sequenceFlow id="FFR_b30997186b68599888bb576306bf2a40" isImmediate="true" sourceRef="FFR_2ea495e8bf035f929dd0e2c5951acab1" targetRef="FFR_40b5ba6e124a5e56a0d993bc67897831"/>
         <sequenceFlow id="FFR_6114f8902be35e44967e1cdf5dfb067b" isImmediate="true" sourceRef="FFR_840dc2235d2c5d318fd88cb46374d585" targetRef="FFR_f59499a23f4e50b199effe470ac6aafa"/>
