      </task>
      <task completionQuantity="1" id="FFR_cac3ef989079584a8c0f3c564b0c5b10" isForCompensation="false" name="Update Logistics Report" startQuantity="1">
         <documentation id="sid-fe88ff92-5796-4b11-b68b-727037607e85">After each spare dispatch, interstate handover or internal repaired-part dispatch, IM records the item serial and consignment number in the Logistics Report with its assigned shipping day. These records supply the daily closing case. Each accepted per-request path reaches this activity once after its dispatch. Case p.4.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <incoming>FFR_feda88bce3b655efbe57bc035dc141bf</incoming>
         <outgoing>FFR_26fcf7387cd0553bbc1919b16fe2d759</outgoing>
      </task>
      <task completionQuantity="1" id="FFR_4b7e3374cc3957cc95f91b24669e44d2" isForCompensation="false" name="Check reference part type list" startQuantity="1">
         <documentation id="sid-d7c5f61d-c1e3-4481-93ee-5cad82556782">When no identical database spare is available, IM checks the Parts Type List to identify interstate-subcontractor work (5 minutes). Case p.4.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <incoming>FFR_5f5befde85925f70bde8aaf0152ccf6d</incoming>
         <outgoing>FFR_f7643b17575a51b9983aa3f1255fd388</outgoing>
      </task>
      <task completionQuantity="1" id="FFR_415dc5100f885e229845c5143625e511" isForCompensation="false" name="Print shipping ticket" startQuantity="1">
         <documentation id="sid-3c9be733-41ac-4f58-ad8e-101964fb7e5a">IM prints the interstate shipping ticket (3 minutes) before the after-3pm subcontractor dispatch. Case p.4.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <incoming>FFR_bbbf88e856795f23ab22376f794d3570</incoming>
         <outgoing>FFR_960f03e3668f55388c9ffce1df88900d</outgoing>
      </task>
      <task completionQuantity="1" id="FFR_d23266dc529d58fdb3bdf2f2e1c11bc4" isForCompensation="false" name="Dispatch to interstate subcontractor" startQuantity="1">
         <documentation id="sid-715313f6-31d2-496e-888b-0a009858be44">After 3pm, IM dispatches the part to the interstate subcontractor and continues CRN and Logistics Report recording. This is external handover, not repair completion. Case p.4.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <incoming>FFR_5bbb79c67d7a59b5bac0b05a5aa5d20a</incoming>
         <outgoing>FFR_7c40f86e80555e49b123e7218f3ed389</outgoing>
      </task>
      <intermediateCatchEvent id="FFR_00f5445e4d7153928581c888ed145d7e" name="after 3pm">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
            <signavio:signavioLabel ref="text_name" valign="middle" x="15.0" y="-29.0"/>
         </extensionElements>
         <incoming>FFR_960f03e3668f55388c9ffce1df88900d</incoming>
         <outgoing>FFR_5bbb79c67d7a59b5bac0b05a5aa5d20a</outgoing>
         <timerEventDefinition id="sid-9a876ef2-03b3-4c86-ae22-407a63b33771">
            <timeDate id="sid-f11ed63e-a68a-44de-b2f8-27de4705b5ea" xsi:type="tFormalExpression">applicableWorkingDayAfter15:00</timeDate>
         </timerEventDefinition>
      </intermediateCatchEvent>
      <exclusiveGateway gatewayDirection="Diverging" id="FFR_521a2fbad1735cdb9b033e79f3798de4" name="Repaired by&#10; subcontractor?">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
            <signavio:signavioLabel align="center" ref="text_name" valign="middle" x="-36.0" y="65.0"/>
         </extensionElements>
         <incoming>FFR_f7643b17575a51b9983aa3f1255fd388</incoming>
         <outgoing>FFR_cf35b43bd3f8541389b2bd78efb7b577</outgoing>
         <outgoing>FFR_42d160066f4950fb9d40d06f21eaf7da</outgoing>
      </exclusiveGateway>
      <task completionQuantity="1" id="FFR_6c00de057c675de6bb9a17e4fc5be0a8" isForCompensation="false" name="Meet workshop technician" startQuantity="1">
         <documentation id="sid-13531095-fcef-4cd0-b9c9-48cdf6eed67c">IM meets the workshop technician to assess internal repair; the 30-minute meeting includes 10 minutes IM travel. Repairability is determined through the subsequent repair steps. Case p.4.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <incoming>FFR_cf35b43bd3f8541389b2bd78efb7b577</incoming>
         <outgoing>FFR_2206e8785a6758c89af1f92d8fead330</outgoing>
      </task>
      <endEvent id="FFR_cd0f49a0957d51d6bb5623b6265b0279" name="Consignment&#10;logged">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
            <signavio:signavioLabel align="left" ref="text_name" x="-36.59999999999991" y="46.5"/>
         </extensionElements>
         <incoming>FFR_26fcf7387cd0553bbc1919b16fe2d759</incoming>
      </endEvent>
      <startEvent id="FFR_3eaf74c338a759dd90a34dec33f183e4" isInterrupting="true" name="Once daily&#10;Closing review&#10;after 3pm">
         <documentation id="sid-1afa86a7-a790-4b41-a5fe-0fe30be6774a">Start one closing review per working day after 3pm. The closing subprocess selects its signed-off current-day batch and checks the Logistics Report and completed-work conditions. Open external and future-day jobs carry forward; the three starts do not join their sequence-flow tokens.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
            <signavio:signavioLabel align="left" ref="text_name" x="-32.10000000000002" y="38.39999999999998"/>
         </extensionElements>
         <outgoing>FFR_a5faf9f548dd5141b297fb7c280da43f</outgoing>
         <timerEventDefinition id="sid-43dc0785-1080-4e59-9a63-1cc7abc9e595">
            <timeCycle id="sid-c9a3593b-8299-44df-8bf4-e7974b5caffd" xsi:type="tFormalExpression">eachWorkingDayAtScheduledClosingReviewAfter15:00</timeCycle>
         </timerEventDefinition>
      </startEvent>
      <exclusiveGateway gatewayDirection="Converging" id="FFR_2e021ed1b93256dd8b8e79d2e49b936e">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <incoming>FFR_4d84b4b74fa251a086095037912d636c</incoming>
         <incoming>FFR_42d160066f4950fb9d40d06f21eaf7da</incoming>
         <outgoing>FFR_bbbf88e856795f23ab22376f794d3570</outgoing>
      </exclusiveGateway>
      <exclusiveGateway gatewayDirection="Diverging" id="FFR_91d77bbc282558eea1f5e7c64bf84442" name="Received within&#10;8am-5pm?">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
            <signavio:signavioLabel ref="text_name" x="-50.5" y="-56.5"/>
         </extensionElements>
         <incoming>FFR_e5a674de97e75ccfb40a840ea2a1ceab</incoming>
         <outgoing>FFR_43f2ee0c5db9539f9aedaa39b75ce3e6</outgoing>
         <outgoing>FFR_99a1550630b655118610bfc287ee8c3c</outgoing>
      </exclusiveGateway>
      <task completionQuantity="1" id="FFR_e78543253e7d5057be979761d3cbaad6" isForCompensation="false" name="Assess out-of-hours acceptance" startQuantity="1">
         <documentation id="sid-5f75a312-4782-4a83-9662-448667042868">SLA permits rejection before 08:00 or after 17:00, but rejection happens only sometimes. IM decides whether to accept. Boundary times are treated as within hours. Case p.5; placement before fulfilment is a modelling assumption.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <incoming>FFR_99a1550630b655118610bfc287ee8c3c</incoming>
         <outgoing>FFR_f6e5c21be1415c5b8d6066299e3356d6</outgoing>
      </task>
      <exclusiveGateway gatewayDirection="Diverging" id="FFR_92f721fd67815167b38b43fdd762c069" name="Accept request?">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
            <signavio:signavioLabel ref="text_name" x="-14.5" y="51.5"/>
         </extensionElements>
         <incoming>FFR_f6e5c21be1415c5b8d6066299e3356d6</incoming>
         <outgoing>FFR_83119aeb37a85571888cf9d53e9a8ddd</outgoing>
         <outgoing>FFR_728fdaf814ca5093805b012a3e4aee90</outgoing>
      </exclusiveGateway>
      <task completionQuantity="1" id="FFR_3d8a95b98202542d8adfde3892efae18" isForCompensation="false" name="Record SLA rejection" startQuantity="1">
         <documentation id="sid-82809d42-3fa8-42cc-8940-269d01965198">Record the IM decision against the request. An out-of-hours SLA decline is distinct from an irrelevant physical part being returned with a special label.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <incoming>FFR_728fdaf814ca5093805b012a3e4aee90</incoming>
         <outgoing>FFR_b2a6480639bd594e888e14e853c57091</outgoing>
      </task>
      <endEvent id="FFR_b8a7e339ec5a5e57a36ae69043a09381" name="Request declined under SLA">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
            <signavio:signavioLabel align="left" ref="text_name" x="-50.10000000000002" y="47.39999999999998"/>
         </extensionElements>
         <incoming>FFR_b2a6480639bd594e888e14e853c57091</incoming>
      </endEvent>
      <exclusiveGateway gatewayDirection="Converging" id="FFR_385e046288dd51de9356fde673fda95c">
         <documentation id="sid-1c348eeb-79dc-4289-abfb-449a85714787">Merge the mutually exclusive in-hours acceptance and discretionary out-of-hours acceptance paths. Query spare availability once per accepted request.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <incoming>FFR_43f2ee0c5db9539f9aedaa39b75ce3e6</incoming>
         <incoming>FFR_83119aeb37a85571888cf9d53e9a8ddd</incoming>
         <outgoing>FFR_c5212e2d16065479bbabb8c17b54d271</outgoing>
      </exclusiveGateway>
      <task completionQuantity="1" id="FFR_a6599147ad1a513fa5a8f25fc07e2979" isForCompensation="false" name="Dispatch repaired part to PrimeTech" startQuantity="1">
         <documentation id="sid-30b3a60b-b33d-4cb7-b1d3-d66c3cc6d81a">At the applicable 3pm working-part slot, IM dispatches the workshop-repaired item from the Urgent repair tray. Continue to the common paper-CRN and Logistics Report activities. The repaired request may still show stale Open status until daily manual finalisation. Case pp.4-6.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <incoming>FFR_899d88e5433c500fb873b3af59eeee33</incoming>
         <outgoing>FFR_1adce1a162e651d79814a380fe871c67</outgoing>
      </task>
      <task completionQuantity="1" id="FFR_37a3deee1ffb58f9b3bbbf48ff0bb2dc" isForCompensation="false" name="Check previous-day deliveries" startQuantity="1">
         <documentation id="sid-f9e01d27-8618-458a-b1b5-94eff511fad5">Once daily, IO checks the part-delivery spreadsheet for deliveries and repair records from the previous day. The following returns and tracking subprocesses repeat over that record set. Case pp.4-5.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <incoming>FFR_98551bf14d1056519aba7408856ac198</incoming>
         <outgoing>FFR_ce8fbe65c9b053b78154ff051935a6f6</outgoing>
      </task>
      <task completionQuantity="1" id="FFR_48ee1974b29b52bfa0ffded35c3a1228" isForCompensation="false" name="Place missed items in Urgent repair tray" startQuantity="1">
         <documentation id="sid-dfeb0c51-45e8-428d-a6e7-19e65adec460">After the daily physical inspection and database observation update, IO puts identified missed/misplaced items in the Urgent repair tray. Case p.5.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <incoming>FFR_1fa8c02d5deb5279ba299ccd42a8b48a</incoming>
         <outgoing>FFR_67bf77e4f21c5bc79159f332189c16fe</outgoing>
      </task>
      <task completionQuantity="1" id="FFR_5fb10d5c97a557c1883a771ed2c5d412" isForCompensation="false" name="Refer urgent items and set deadlines" startQuantity="1">
         <documentation id="sid-178782e2-4688-4a38-970d-aacf62a7f472">For each identified missed/misplaced item, IO sends it to the distinct ON-CALL repairer and records its actual handover time, CRN/work-order-line and serial; initialise nextNoticeAt = handover + P1D. Referral is repeated per item without waiting for prior item repairs. All returns are correlated with these records. Case p.5. The recorded outstanding set supplies the earliest nextNoticeAt directly to the event-based wait; no separate review activity is required between waits.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <incoming>FFR_67bf77e4f21c5bc79159f332189c16fe</incoming>
         <outgoing>FFR_4b5bcd569f1d58fd8cba6179449a1498</outgoing>
         <multiInstanceLoopCharacteristics behavior="All" id="sid-92cb17aa-c33e-466a-9bd5-59569429c65f" isSequential="true">
            <loopCardinality id="sid-93248c4c-6616-4821-abcf-2a2749807734">numberOfMissedOrMisplacedItems</loopCardinality>
         </multiInstanceLoopCharacteristics>
      </task>
      <eventBasedGateway eventGatewayType="Exclusive" gatewayDirection="Diverging" id="FFR_3c7d0c290b9358d09f6ff392f5468c8f" instantiate="false">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <incoming>FFR_657b418b50a058bea08f003a7d6fdcbe</incoming>
         <outgoing>FFR_7fda93536b9a58ce921159a75f0cdfd0</outgoing>
         <outgoing>FFR_12a44b6532565a5797f863d6681f8f42</outgoing>
      </eventBasedGateway>
      <intermediateCatchEvent id="FFR_e57c2441bd1d538cbc8ffe83f3d6ced8" name="Repaired item&#10;received">
         <documentation id="sid-41b29db4-c6d6-4528-80b1-7d49572d5109">Catch the actual return of any one outstanding item in this review case, whether timely or late. Identify that item by serial and request references. Receipt is not inferred from a timer. Physical returns arriving while IO records a notice are retained for the next wait.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
            <signavio:signavioLabel align="left" ref="text_name" x="-36.60000000000002" y="37.5"/>
         </extensionElements>
         <incoming>FFR_7fda93536b9a58ce921159a75f0cdfd0</incoming>
         <outgoing>FFR_c56185ddfc7b58a8a72b8731cf10fe13</outgoing>
         <messageEventDefinition id="sid-fb325b80-405d-46ee-9425-5c13e01a0d13" messageRef="FFR_d00eae7e41935039ba841dc596774df0"/>
      </intermediateCatchEvent>
      <intermediateCatchEvent id="FFR_c2e02723a480568fb95044d03f9e8e72" name="Next notice due">
         <documentation id="sid-8539ff7d-a764-4a6a-a49d-32c8ab59b2b5">Absolute due date, initially handover plus one day for each item. Re-evaluated after every receipt or notice, retaining each remaining item deadline. It is not a fresh one-day duration restarted after another item returns.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
            <signavio:signavioLabel align="left" ref="text_name" x="-36.60000000000002" y="38.39999999999998"/>
         </extensionElements>
         <incoming>FFR_12a44b6532565a5797f863d6681f8f42</incoming>
         <outgoing>FFR_5f66c8d13a5953cc89a518895d4cd2fd</outgoing>
         <timerEventDefinition id="sid-10c3b11c-06e9-4dc1-b018-d2b879f55458">
            <timeDate id="sid-0990eddf-f7c6-4a58-8e76-c284c87ba16c" xsi:type="tFormalExpression">earliest nextNoticeAt among this review case outstanding referrals</timeDate>
         </timerEventDefinition>
      </intermediateCatchEvent>
      <exclusiveGateway gatewayDirection="Converging" id="FFR_731b5c9472a2501ebf42c10b9c5b188d">
         <documentation id="sid-314c545c-32f7-40e5-898e-77033079798c">Merge the alternative initial referral, late-notice and remaining-items paths into one entry to the event-based wait. This is an XOR merge, without synchronisation.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <incoming>FFR_4b5bcd569f1d58fd8cba6179449a1498</incoming>
         <incoming>FFR_ed8ca5e34fbd54e790b9c1dd1d6b1df2</incoming>
         <incoming>FFR_54156d9e52815b5e83ced546bfb9ce8d</incoming>
         <outgoing>FFR_657b418b50a058bea08f003a7d6fdcbe</outgoing>
      </exclusiveGateway>
      <task completionQuantity="1" id="FFR_1191d8fb76175e04b2407924b8519557" isForCompensation="false" name="Dispatch repaired part to PrimeTech" startQuantity="1">
         <documentation id="sid-669e2e52-a570-4d5c-af37-aaf0905c5f38">Only after actual receipt from the on-call repairer, IO dispatches the repaired part to PrimeTech (3 minutes). Record finalised status in the next activity. Case p.5.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
         </extensionElements>
         <incoming>FFR_c56185ddfc7b58a8a72b8731cf10fe13</incoming>
         <outgoing>FFR_2ac5c63123755de4b2b757e25ad789ea</outgoing>
      </task>
      <endEvent id="FFR_8a2169ce6f2c508fa9b6b5b2ba52b248" name="Daily review&#10;complete">
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffff"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
            <signavio:signavioLabel align="left" ref="text_name" x="-54.59999999999991" y="-43.5"/>
         </extensionElements>
         <incoming>FFR_cab0281d2e7b55eea745e451368c2188</incoming>
      </endEvent>
      <subProcess completionQuantity="1" id="FFR_c102b5e9226d510bad741b5b3cbb1c83" isForCompensation="false" name="Record daily returns" startQuantity="1" triggeredByEvent="false">
         <documentation id="sid-ca359720-0732-4c1c-bf53-86820a4ffc1f">Once per previous-day returned record within the daily IO review: check serial, branch on receipt advice, then write the audit/training information in both cases. Case pp.4-5.</documentation>
         <extensionElements>
            <signavio:signavioMetaData metaKey="bgcolor" metaValue="#ffffcc"/>
            <signavio:signavioMetaData metaKey="bordercolor" metaValue="#000000"/>
            <signavio:signavioDiagramMetaData metaKey="revisionid" metaValue="958edd8814d849eabe85294aa2fb3818"/>
         </extensionElements>
         <incoming>FFR_ce8fbe65c9b053b78154ff051935a6f6</incoming>
         <outgoing>FFR_2c8394bcd9cc5a33bf5d5f6b256803dd</outgoing>
         <multiInstanceLoopCharacteristics behavior="All" id="sid-0ce5bf32-a410-4f3e-b0ab-c1889bcfbe4d" isSequential="true">
            <loopCardinality id="sid-f7a65cc9-87a9-48ea-b2ff-2bec9ce0b0c1">previousDayDeliveryRecordCount</loopCardinality>
         </multiInstanceLoopCharacteristics>
         <laneSet id="sid-2b74b0d6-47db-4ffe-a8f9-919ec83268ed" name="Record daily returns">
            <lane id="FFR_9caebb2b4d3d5b75b96d3e01e8bc3daf" name="Inventory Officer">
               <flowNodeRef>FFR_06a5204b7be954e7abfc64173cdf57af</flowNodeRef>
               <flowNodeRef>FFR_6cc2b07d611f55229332465e8b0eee87</flowNodeRef>
               <flowNodeRef>FFR_ee92a575f42b56b29419eff42ed856f0</flowNodeRef>
               <flowNodeRef>FFR_49fc6ea8011d54f586d0151aff52963c</flowNodeRef>
               <flowNodeRef>FFR_176e739a185c5e188371facf1d2370ff</flowNodeRef>
               <flowNodeRef>FFR_e6cdb61c341f5443bea9bcb85eb1fef8</flowNodeRef>
               <flowNodeRef>FFR_24e38294f6fa531eac9723f8c9c615c8</flowNodeRef>
               <flowNodeRef>FFR_ddfe4a4f0b8e547aa09b130f9e192a58</flowNodeRef>
               <flowNodeRef>FFR_bc546dca60cc540e8fe774122b282c51</flowNodeRef>
            </lane>
         </laneSet>
         <task completionQuantity="1" id="FFR_06a5204b7be954e7abfc64173cdf57af" isForCompensation="false" name="Check serial number" startQuantity="1">
